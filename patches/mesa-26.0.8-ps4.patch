+int32_t sceVideoOutRegisterBuffers(int32_t handle, int32_t start, void *const *addresses, int32_t count,
+                                   const struct ps4_video_out_buffer_attribute *attribute);
+int32_t sceVideoOutUnregisterBuffers(int32_t handle, int32_t set);
+int32_t sceVideoOutSubmitFlip(int32_t handle, int32_t buffer, uint32_t mode, int64_t argument);
+void sceVideoOutSetBufferAttribute(void *attribute, uint32_t format, uint32_t tiling, uint32_t aspect,
+                                   uint32_t width, uint32_t height, uint32_t pixel_pitch);
+int32_t sceVideoOutSetFlipRate(int32_t handle, int32_t rate);
+int32_t sceVideoOutAddFlipEvent(void *queue, int32_t handle, void *data);
