+/* Images in each swapchain, and swapchain slots: VideoOut has 16 buffer indices. */
+#define VIDEOOUT_IMAGES 3
+#define VIDEOOUT_SLOTS 5
+#define VIDEOOUT_BUFFER_ALIGNMENT (UINT64_C(2) << 20)
+#define VIDEOOUT_REFRESH_MILLIHERTZ 59940
+
+#define PS4_VIDEO_OUT_USER_MAIN 0xff
+#define PS4_VIDEO_OUT_BUS_MAIN 0
+#define PS4_VIDEO_OUT_FLIP_VSYNC 1
+#define PS4_VIDEO_OUT_TILING_LINEAR 1
+#define PS4_VIDEO_OUT_ASPECT_16_9 0
+/* Byte order in memory: A8R8G8B8 is B, G, R, A; A8B8G8R8 is R, G, B, A. */
+#define PS4_VIDEO_OUT_PIXEL_FORMAT_A8R8G8B8_SRGB 0x80000000u
+#define PS4_VIDEO_OUT_PIXEL_FORMAT_A8B8G8R8_SRGB 0x80002200u
+
+struct ps4_video_out_buffer_attribute {
+   int32_t format;
+   int32_t tiling;
+   int32_t aspect;
+   uint32_t width;
+   uint32_t height;
+   uint32_t pixel_pitch;
+   uint64_t reserved[2];
+};
+
+struct ps4_video_out_flip_status {
+   uint64_t count;
+   uint64_t process_time;
+   uint64_t tsc_time;
+   int64_t flip_argument;
+   uint64_t reserved[2];
+   int32_t gpu_flips_pending;
+   int32_t flips_pending;
+   int32_t current_buffer;
+   uint32_t reserved1;
+};
