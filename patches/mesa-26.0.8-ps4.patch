diff --git a/src/vulkan/wsi/wsi_common_videoout.c b/src/vulkan/wsi/wsi_common_videoout.c
new file mode 100644
index 0000000..8ab2d28
--- /dev/null
+++ b/src/vulkan/wsi/wsi_common_videoout.c
@@ -0,0 +1,1112 @@
+/*
+ * Copyright © 2026 Mihawk
+ * Copyright © 2026 dusklight-ps4
+ *
+ * SPDX-License-Identifier: MIT
+ */
+
+/*
+ * VK_KHR_display on the PlayStation 4's one display, VideoOut, in place of
+ * the DRM backend (wsi_common_display.c), which the console does not have.
+ *
+ * Adapted from the PS5 Mesa fork's backend of the same name
+ * (github.com/mihawk-99/PS5_Mesa, src/vulkan/wsi/wsi_common_videoout.c):
+ * the same display, mode, acquire and flip logic, with the PS4's VideoOut
+ * calls. What differs is where the framebuffers come from. The PS4's RADV
+ * (DolphinPS4's GNM winsys) cannot import host memory, so a swapchain's
+ * images are linear images in the device's own host-visible memory, each
+ * bound at a 2 MiB-aligned offset as VideoOut takes buffers, and registered
+ * with VideoOut as the swapchain's set, as DolphinPS4's own swapchain does.
+ *
+ * The display has one plane and one mode, 1920x1080 at 59.94 Hz; VideoOut
+ * scales the buffers to the output.
+ *
+ * A set's buffers are VideoOut buffer indices slot * VIDEOOUT_IMAGES on. A
+ * destroyed swapchain's set is unregistered; VideoOut refuses that while one
+ * of its buffers is on screen (as when a new swapchain has not flipped yet),
+ * and then the set and its memory are kept, the slot retired until a later
+ * swapchain's creation unregisters it.
+ *
+ * A present waits for the frame on a thread and flips it with
+ * sceVideoOutSubmitFlip at the next vblank; FIFO is the only present mode. An
+ * acquire takes a buffer that is neither on screen, nor waiting for its flip
+ * to show, nor held by an application, the one flipped longest ago, and
+ * waits for a flip when none is.
+ */
