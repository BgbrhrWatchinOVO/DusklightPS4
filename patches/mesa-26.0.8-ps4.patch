+
+struct wsi_videoout_swapchain;
+
+/* A present waiting for its frame before its flip. */
+struct wsi_videoout_present {
+   struct wsi_videoout_swapchain *chain;
+   uint32_t buffer;
+   VkFence fence;
+};
+
+/* VideoOut, its buffer sets and what each buffer holds, under lock. */
+struct wsi_videoout_output {
+   mtx_t lock;
+   cnd_t changed;
+   bool opened;
+   int handle;
+   void *flip_queue;
+   /* VideoOut's set for each slot, -1 for a free slot. A retired slot's set
+    * was refused unregistering and is still VideoOut's. */
+   struct {
+      int set;
+      bool retired;
+   } slots[VIDEOOUT_SLOTS];
+   /* The argument of the latest flip submitted; each flip's is one more. */
+   int64_t flip_argument;
+   struct {
+      /* The argument this buffer was last flipped with, 0 before its first flip. */
+      int64_t argument;
+      /* An application holds it, acquired and not yet presented. */
+      bool held;
+      /* Presented, its flip waiting for the frame. */
+      bool pending;
+   } buffer[VIDEOOUT_IMAGES * VIDEOOUT_SLOTS];
+   /* The swapchain presenting now; older ones are retired. */
+   struct wsi_videoout_swapchain *current;
+
+   /* The flip thread and its queue. */
+   bool thread_started;
+   thrd_t thread;
+   struct wsi_videoout_present queue[VIDEOOUT_IMAGES * 2];
+   uint32_t queue_head, queue_count;
+};
+
+static struct wsi_videoout_output videoout_output = {
+   .handle = -1,
+};
+static once_flag videoout_once = ONCE_FLAG_INIT;
+
+static void
+videoout_output_init_once(void)
+{
+   mtx_init(&videoout_output.lock, mtx_plain);
+   cnd_init(&videoout_output.changed);
+   for (uint32_t i = 0; i < VIDEOOUT_SLOTS; i++)
+      videoout_output.slots[i].set = -1;
+}
+
+struct wsi_videoout_swapchain {
+   struct wsi_swapchain base;
+   /* Its slot: image i is VideoOut buffer first + i. */
+   uint32_t slot;
+   uint32_t first;
+   bool retired;
+   /* Presents queued and not yet flipped. */
+   uint32_t in_flight;
+   struct wsi_image images[VIDEOOUT_IMAGES];
+};
+
+struct wsi_videoout {
+   struct wsi_interface base;
+};
+
+/* --- VideoOut ------------------------------------------------------------ */
+
+/* Opens VideoOut once per process. Under lock. */
+static bool
+videoout_open_locked(void)
+{
+   struct wsi_videoout_output *out = &videoout_output;
+   if (out->opened)
+      return out->handle >= 0;
+   out->opened = true;
+   out->handle = sceVideoOutOpen(PS4_VIDEO_OUT_USER_MAIN, PS4_VIDEO_OUT_BUS_MAIN, 0, NULL);
+   if (out->handle < 0) {
+      fprintf(stderr, "wsi/videoout: sceVideoOutOpen failed: 0x%08x\n", (unsigned)out->handle);
+      return false;
+   }
+   if (sceKernelCreateEqueue(&out->flip_queue, "wsi videoout flip") == 0)
+      sceVideoOutAddFlipEvent(out->flip_queue, out->handle, NULL);
+   sceVideoOutSetFlipRate(out->handle, 0);
+   return true;
+}
+
+/* The PS4 profiler (Dusklight's ps4/prof/ps4prof_c.h); ac_ps4_drm.c has weak no-ops. */
+void *ps4prof_enter(void **site, const char *name);
+void ps4prof_leave(void *zone);
+void ps4prof_thread_busy(const char *name);
+
+/* Waits for a flip to show, or 5 ms. */
+static void
+videoout_wait_flip(void *queue)
+{
+   uint64_t event[8];
+   int count = 0;
+   unsigned timeout_us = 5000;
+   if (queue == NULL || sceKernelWaitEqueue(queue, event, 1, &count, &timeout_us) != 0)
+      os_time_sleep(1000);
+}
+
+static int64_t
+videoout_shown_argument_locked(void)
+{
+   struct ps4_video_out_flip_status status;
+   memset(&status, 0, sizeof(status));
+   if (videoout_output.flip_argument == 0 || sceVideoOutGetFlipStatus(videoout_output.handle, &status) != 0)
+      return 0;
+   return status.flip_argument;
+}
+
+/* Unregisters a slot's set. Under lock. */
+static bool
+videoout_unregister_locked(uint32_t slot)
+{
+   struct wsi_videoout_output *out = &videoout_output;
+   const int result = sceVideoOutUnregisterBuffers(out->handle, out->slots[slot].set);
+   if (result != 0)
+      return false;
+   out->slots[slot].set = -1;
+   out->slots[slot].retired = false;
+   for (uint32_t i = 0; i < VIDEOOUT_IMAGES; i++)
+      memset(&out->buffer[slot * VIDEOOUT_IMAGES + i], 0, sizeof(out->buffer[0]));
+   return true;
+}
+
+/* A free slot, after unregistering retired sets VideoOut no longer shows.
+ * UINT32_MAX when none is. Under lock. */
+static uint32_t
+videoout_free_slot_locked(void)
+{
+   struct wsi_videoout_output *out = &videoout_output;
+   for (uint32_t i = 0; i < VIDEOOUT_SLOTS; i++)
+      if (out->slots[i].retired)
+         videoout_unregister_locked(i);
+   for (uint32_t i = 0; i < VIDEOOUT_SLOTS; i++)
+      if (out->slots[i].set < 0)
+         return i;
+   return UINT32_MAX;
+}
+
+/* The flip thread: each present's flip once its frame is done, in order. */
+static int
+videoout_flip_thread(void *data)
+{
+   struct wsi_videoout_output *out = &videoout_output;
+   mtx_lock(&out->lock);
+   for (;;) {
+      while (out->queue_count == 0)
+         cnd_wait(&out->changed, &out->lock);
+      const struct wsi_videoout_present present = out->queue[out->queue_head];
+      mtx_unlock(&out->lock);
+
+      struct wsi_videoout_swapchain *chain = present.chain;
+      const struct wsi_device *wsi = chain->base.wsi;
+      ps4prof_thread_busy("wsi flip");
+      static void *fence_site;
+      void *fence_zone = ps4prof_enter(&fence_site, "wsi flip: wait for the GPU to finish the frame");
+      wsi->WaitForFences(chain->base.device, 1, &present.fence, VK_TRUE, UINT64_MAX);
+      ps4prof_leave(fence_zone);
+
+      mtx_lock(&out->lock);
+      const int64_t argument = out->flip_argument + 1;
+      const int result =
+         sceVideoOutSubmitFlip(out->handle, (int32_t)present.buffer, PS4_VIDEO_OUT_FLIP_VSYNC, argument);
+      if (result == 0) {
+         out->flip_argument = argument;
+         out->buffer[present.buffer].argument = argument;
+      } else {
+         fprintf(stderr, "wsi/videoout: sceVideoOutSubmitFlip(%u) failed: 0x%08x\n", present.buffer,
+                 (unsigned)result);
+      }
+      out->buffer[present.buffer].pending = false;
+      out->queue_head = (out->queue_head + 1) % ARRAY_SIZE(out->queue);
+      out->queue_count--;
+      chain->in_flight--;
+      cnd_broadcast(&out->changed);
+   }
+   return 0;
+}
