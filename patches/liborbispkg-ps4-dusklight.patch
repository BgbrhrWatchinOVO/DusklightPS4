@@ -433,7 +433,11 @@ namespace LibOrbisPkg.PKG
             0x80000) + pfsSize;
           // Add the size of the chunk SHAs, plus an extra 16 bytes for good measure
           pkgSize += ((pkgSize + 16) / 0x10000) * 4;
-          e.DataSize = (uint)(pkgSize / 0x10000L) * 4;
+          // The estimate falls short for multi-GB packages (the PFS image ends up larger than
+          // pfsSize): reserve 1/8 more chunks plus 16384 (1 GiB of PKG); the size is set to the
+          // exact one once the PKG size is known (below).
+          long chunks = pkgSize / 0x10000L;
+          e.DataSize = (uint)((chunks + chunks / 8 + 0x4000) * 4);
         }
 
         dataOffset = Align(dataOffset + e.DataSize, 16);
