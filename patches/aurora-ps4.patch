+// Several values in one write, big-endian as the separate writes would store them: one capacity
+// check and one copy instead of one per value (vertex attributes are written per vertex).
+template <typename... T>
+ALWAYS_INLINE void write_values(const T... values) {
+  uint8_t bytes[(sizeof(T) + ...)];
+  size_t offset = 0;
+  (
+      [&] {
+        if constexpr (sizeof(T) == 1) {
+          bytes[offset] = static_cast<uint8_t>(values);
+        } else {
+          const auto swapped = bswap(values);
+          std::memcpy(bytes + offset, &swapped, sizeof(swapped));
+        }
+        offset += sizeof(T);
+      }(),
+      ...);
+  write_data(bytes, sizeof(bytes));
+}
+
 inline void write_u16(const uint16_t val) {
   const auto out = bswap(val);
   write_data(&out, sizeof(out));
