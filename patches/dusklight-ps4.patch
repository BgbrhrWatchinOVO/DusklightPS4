+/* SPDX-License-Identifier: MIT
+ * The PS4 profiler (ps4_profiler.hpp) for code built outside the game, in C or C++: Dawn and Mesa.
+ * A zone:
+ *     static void *site;
+ *     void *zone = ps4prof_enter(&site, "vk: queue submit");
+ *     ...
+ *     ps4prof_leave(zone);
+ * The symbols come from the game (ps4/prof/ps4_profiler.cpp); declare them weak where a library
+ * may be linked without it. */
+#pragma once
+#ifdef __cplusplus
+extern "C" {
+#endif
+void *ps4prof_enter(void **site, const char *name);
+void ps4prof_leave(void *zone);
+/* Call from a thread's loop (cheap; samples at most every 2 ms): its CPU time is reported as
+ * "name N%" per slow second and summary. */
+void ps4prof_thread_busy(const char *name);
+/* A line in the scene timeline (stage names and the like). */
+void ps4prof_scene_note(const char *text);
+#ifdef __cplusplus
+}
+#endif
