@@ -0,0 +1,47 @@
+// Code mods linked into the PS4 build (ps4/Platform.cmake compiles each with its five exports
+// renamed, so several can coexist), looked up by the key their package's mod.so holds.
+#include <cstring>
+
+#include <mods/api.h>
+
+#include "dusk/mods/loader/static_module.hpp"
+
+#if defined(PS4_MOD_TWILIGHT_HD)
+extern "C" {
+extern const ModMeta twilight_hd_hud_mod_meta;
+extern ModContext* twilight_hd_hud_mod_ctx;
+ModResult twilight_hd_hud_mod_initialize(ModError* out_error);
+ModResult twilight_hd_hud_mod_update(ModError* out_error);
+ModResult twilight_hd_hud_mod_shutdown(ModError* out_error);
+}
+#endif
+
+namespace dusk::mods::loader {
+namespace {
+#if defined(PS4_MOD_TWILIGHT_HD)
+const StaticModuleSymbol kTwilightHd[] = {
+    {"mod_meta", const_cast<ModMeta*>(&twilight_hd_hud_mod_meta)},
+    {"mod_ctx", &twilight_hd_hud_mod_ctx},
+    {"mod_initialize", reinterpret_cast<void*>(&twilight_hd_hud_mod_initialize)},
+    {"mod_update", reinterpret_cast<void*>(&twilight_hd_hud_mod_update)},
+    {"mod_shutdown", reinterpret_cast<void*>(&twilight_hd_hud_mod_shutdown)},
+};
+#endif
+
+const StaticModule kModules[] = {
+#if defined(PS4_MOD_TWILIGHT_HD)
+    {"twilight_hd_hud", kTwilightHd, sizeof(kTwilightHd) / sizeof(kTwilightHd[0])},
+#endif
+    {nullptr, nullptr, 0},
+};
+}  // namespace
+
+const StaticModule* find_static_module(const char* key) noexcept {
+    for (const auto& module : kModules) {
+        if (module.key != nullptr && key != nullptr && std::strcmp(module.key, key) == 0) {
+            return &module;
+        }
+    }
+    return nullptr;
+}
+}  // namespace dusk::mods::loader
