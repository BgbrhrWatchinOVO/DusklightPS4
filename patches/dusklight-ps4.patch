diff --git a/ps4/Platform.cmake b/ps4/Platform.cmake
new file mode 100644
index 00000000000..730fe67d767
--- /dev/null
+++ b/ps4/Platform.cmake
@@ -0,0 +1,207 @@
+# PS4 application integration (OpenOrbis homebrew), after ps5/Platform.cmake. Desktop builds do not
+# include this file. Configured by the dusklight-ps4 project's tools/build-game.sh with DolphinPS4's
+# toolchain (ps4-love-modern.cmake), whose project include (ps4-love-style.cmake) supplies the
+# runtime fixes, linker script, Mesa link and eboot step used here.
+include(FetchContent)
+
+set(PS4_PORT_ROOT "" CACHE PATH "dusklight-ps4 project root (prebuilt Dawn, SDL3 and Mesa)")
+set(PS4_DAWN_BUILD_DIR "${PS4_PORT_ROOT}/build/dawn" CACHE PATH "Cross-built Dawn directory")
+set(PS4_DAWN_SOURCE_DIR "${PS4_PORT_ROOT}/src/dawn" CACHE PATH "Dawn source directory")
+
+add_compile_options(-ffunction-sections -fdata-sections -fno-omit-frame-pointer)
+
+# The executable links with ld.lld directly, which takes no -pthread (FindThreads' choice for this
+# clang): threads are the OpenOrbis libpthread stubs. FindThreads keeps an existing target.
+add_library(Threads::Threads INTERFACE IMPORTED GLOBAL)
+set_target_properties(Threads::Threads PROPERTIES INTERFACE_LINK_LIBRARIES pthread)
+
+# Dawn, built separately by tools/build-dawn.sh, as on PS5.
+if (EXISTS "${PS4_DAWN_BUILD_DIR}/gen/include/dawn/webgpu_cpp.h")
+    add_library(webgpu_dawn STATIC IMPORTED GLOBAL)
+    set_target_properties(webgpu_dawn PROPERTIES
+        IMPORTED_LOCATION "${PS4_DAWN_BUILD_DIR}/src/dawn/native/libwebgpu_dawn.a"
+        INTERFACE_INCLUDE_DIRECTORIES "${PS4_DAWN_SOURCE_DIR}/include;${PS4_DAWN_BUILD_DIR}/gen/include"
+    )
+    add_library(dawn::webgpu_dawn ALIAS webgpu_dawn)
+    add_library(ps4_dawn_headers INTERFACE)
+    add_library(dawn::dawncpp_headers ALIAS ps4_dawn_headers)
+    target_include_directories(ps4_dawn_headers INTERFACE
+        "${PS4_DAWN_SOURCE_DIR}/include" "${PS4_DAWN_BUILD_DIR}/gen/include")
+else ()
+    message(FATAL_ERROR "No PS4 Dawn build in ${PS4_DAWN_BUILD_DIR}: run tools/build-dawn.sh")
+endif ()
+
+# Tracy instrumentation is disabled and only needs headers.
+set(TRACY_ENABLE OFF CACHE BOOL "Enable Tracy profiling" FORCE)
+FetchContent_Declare(tracy
+    URL https://github.com/wolfpld/tracy/archive/refs/tags/v0.14.1.zip
+    URL_HASH SHA256=908f3a2917fa86a247abfcf85dcf04bad1db6986a4d40f94b70512f3e9e98d5b
+    DOWNLOAD_EXTRACT_TIMESTAMP FALSE
+    SOURCE_SUBDIR ps4-headers-only
+)
+FetchContent_MakeAvailable(tracy)
+add_library(ps4_tracy_headers INTERFACE)
+add_library(Tracy::TracyClient ALIAS ps4_tracy_headers)
+add_library(TracyClient ALIAS ps4_tracy_headers)
+target_include_directories(ps4_tracy_headers SYSTEM INTERFACE "${tracy_SOURCE_DIR}/public")
+# The zones and frame marks feed the PS4 profiler instead (ps4/prof): its tracy/Tracy.hpp comes
+# first and includes Tracy's.
+target_include_directories(ps4_tracy_headers BEFORE INTERFACE "${CMAKE_CURRENT_LIST_DIR}/prof")
+target_compile_definitions(ps4_tracy_headers INTERFACE PS4_PROFILER=1)
+
+# Developer tools (tools/build-game.sh FLAVOR=dev, the default): the profiler (frame statistics,
+# zones, sampler), the heap checks of DolphinPS4's runtime on every allocation, the frame counter
+# in the log, INFO logging. The release ("Dusklight", FLAVOR=final) has none of them. The zones'
+# code stays compiled (switched off) in both, so the PGO profile matches either build.
+option(PS4_DEV_TOOLS "Developer tools: profiler, heap checks, diagnostic logs" ON)
+if(PS4_DEV_TOOLS)
+    add_compile_definitions(PS4_DEV_TOOLS=1)
+else()
+    add_compile_definitions(PS4_DEV_TOOLS=0 PS4_HEAP_CHECKS=0)
+endif()
+
+# No Discord IPC, Sentry or desktop crash handlers on the console.
+set(BOREALIS_ENABLE_DISCORD OFF CACHE BOOL "Build Discord integration" FORCE)
+set(BOREALIS_ENABLE_SENTRY OFF CACHE BOOL "Build Sentry integration" FORCE)
+set(BOREALIS_ENABLE_CRASH OFF CACHE BOOL "Build desktop crash handlers" FORCE)
+add_library(ps4_crash STATIC "${CMAKE_CURRENT_LIST_DIR}/crash.cpp")
+add_library(borealis::crash ALIAS ps4_crash)
+
+# Raw GameCube ISOs and decrypted Wii ISOs, through the PS5 port's bounded C++ reader extended to
+# Wii (ps4/disc/raw_disc.cpp) in place of nod (Rust).
+FetchContent_Declare(aurora_nod
+    GIT_REPOSITORY https://github.com/encounter/nod.git
+    GIT_TAG ebd80cac99b48a323200d84365e07a58cc27412d
+    SOURCE_SUBDIR ps4-header-only
+)
+FetchContent_MakeAvailable(aurora_nod)
+add_library(ps4_raw_disc STATIC "${CMAKE_CURRENT_LIST_DIR}/disc/raw_disc.cpp")
+target_include_directories(ps4_raw_disc PUBLIC "${aurora_nod_SOURCE_DIR}/nod-ffi/include")
+target_link_libraries(ps4_raw_disc PRIVATE ps4_tracy_headers)
+add_library(nod::nod ALIAS ps4_raw_disc)
+add_library(nod::nod_static ALIAS ps4_raw_disc)
+
+# The game executable: DolphinPS4's runtime fixes, Dawn, RADV and the console's libraries, then
+# eboot.bin (ps4-love-style.cmake).
+function(ps4_finish_game target)
+    target_sources(${target} PRIVATE "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/main.cpp" ${PS4_RUNTIME_SOURCES}
+        "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/native/realpath.c"
+        "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/prof/ps4_profiler.cpp"
+        "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/tpak.cpp")
+    target_link_libraries(${target} PRIVATE ps4_tracy_headers)
+    # musl's realpath needs /proc (ps4/native/realpath.c); std::filesystem::canonical uses it.
+    target_link_options(${target} PRIVATE "LINKER:--wrap=realpath")
+    if (PS4_PGO STREQUAL "generate")
+        target_sources(${target} PRIVATE "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/pgo.cpp")
+        set_source_files_properties("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/prof/ps4_profiler.cpp"
+            PROPERTIES COMPILE_DEFINITIONS PS4_PGO_GENERATE=1)
+        target_link_libraries(${target} PRIVATE "${PS4_PROFILE_RT}")
+    endif ()
+    ps4_link_mesa(${target})
+    target_link_libraries(${target} PRIVATE
+        z SceSysmodule SceSystemService SceUserService SceVideoOut SceAudioOut ScePad SceNet pthread)
+    ps4_add_code_mods(${target})
+    ps4_add_eboot(${target})
+endfunction()
+
+# ---------------------------------------------------------------------------------------------
+# Profile-guided optimisation (tools/build-game.sh PGO=generate|use). The instrumented build keeps
+# the profile counters and their bounds in .data (orphan sections would land past the loaded
+# image) and links compiler-rt's profile runtime (tools/build-profile-rt.sh).
+set(PS4_PGO "" CACHE STRING "Profile-guided optimisation: empty, generate or use")
+set(PS4_PROFILE_RT "" CACHE FILEPATH "compiler-rt profile runtime for the PS4")
+if (PS4_PGO STREQUAL "generate")
+    file(READ "${PS4_LINK_SCRIPT}" _ps4_script)
+    if (NOT _ps4_script MATCHES "__llvm_prf_cnts")
+        set(_ps4_prf "")
+        foreach (_section cnts data bits vnds names vtab vns)
+            string(APPEND _ps4_prf "\n\t\t. = ALIGN(8);\n\t\t__start___llvm_prf_${_section} = .;\n\t\tKEEP(*(__llvm_prf_${_section}))\n\t\t__stop___llvm_prf_${_section} = .;")
+        endforeach ()
+        string(REPLACE "*(.data .data.*)" "*(.data .data.*)${_ps4_prf}" _ps4_script "${_ps4_script}")
+        file(WRITE "${PS4_LINK_SCRIPT}" "${_ps4_script}")
+    endif ()
+endif ()
+
+# ---------------------------------------------------------------------------------------------
+# Code mods. The PS4 cannot load libraries, so they are linked into the game: each mod becomes an
+# object library with its five exports renamed (ps4/static_mods.cpp lists them), and its package's
+# mod.so holds the module's key (src/dusk/mods/loader/static_module.hpp).
+if (DUSK_ENABLE_CODE_MODS)
+    # Linker script: sections the OpenOrbis script does not list would be placed past the data
+    # segment's file image and start out as zeros on the console. Mod metadata records (with the
+    # bounds mods/meta.hpp expects), the symbol manifest's descriptor and its reserved storage.
+    file(READ "${PS4_LINK_SCRIPT}" _ps4_script)
+    if (NOT _ps4_script MATCHES "modmeta")
+    string(REPLACE "*(.data .data.*)"
+        "*(.data .data.*)\n\t\t. = ALIGN(8);\n\t\tKEEP(*(symdbh))\n\t\t. = ALIGN(8);\n\t\t__start_modmeta = .;\n\t\tKEEP(*(modmeta))\n\t\t__stop_modmeta = .;"
+        _ps4_script "${_ps4_script}")
+    string(REPLACE "*(.rodata .rodata.*)" "*(.rodata .rodata.*)\n\t\t. = ALIGN(16);\n\t\tKEEP(*(ps4_symdb))"
+        _ps4_script "${_ps4_script}")
+    file(WRITE "${PS4_LINK_SCRIPT}" "${_ps4_script}")
+    endif ()
+
+    # Space for the symbol manifest, written after linking (tools/embed-manifest.py).
+    set(PS4_SYMDB_BYTES 8388608 CACHE STRING "Bytes reserved in the image for the symbol manifest")
+    set(PS4_SYMGEN "" CACHE FILEPATH "symgen executable (host)")
+    configure_file("${CMAKE_CURRENT_LIST_DIR}/symdb_storage.cpp.in"
+        "${CMAKE_BINARY_DIR}/ps4_symdb_storage.cpp" @ONLY)
+
+    set(PS4_TWILIGHT_HD_DIR "" CACHE PATH "Twilight HD source (github.com/OTPR26/twilight-hd-hud)")
+    # The libraries besides the game whose functions the linked mods hook, which keep hook-safe
+    # code (no automatic inlining, patchable entries; CMakeLists.txt). Twilight HD: JUTResFont,
+    # J2DPrint/J2DScreen/J2DGrafContext, JMessage::TControl, PADSetVirtualStatus/PADClearVirtualStatus.
+    set(PS4_HOOKED_LIBRARIES JSystem_JUtility JSystem_J2DGraph JSystem_JMessage aurora_pad)
+endif ()
+
+function(ps4_setup_symbol_manifest target)
+    target_sources(${target} PRIVATE "${CMAKE_BINARY_DIR}/ps4_symdb_storage.cpp")
+    # Debug information lets symgen find the hookable functions; it is not loaded on the console.
+    add_custom_command(TARGET ${target} POST_BUILD
+        COMMAND python3 -I "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/tools/embed-manifest.py"
+            --symgen "${PS4_SYMGEN}" --elf "$<TARGET_FILE:${target}>"
+        COMMENT "Writing the symbol manifest into the image"
+        VERBATIM)
+endfunction()
+
+function(ps4_add_code_mods target)
+    if (NOT DUSK_ENABLE_CODE_MODS OR NOT PS4_TWILIGHT_HD_DIR)
+        return()
+    endif ()
+    set(_dir "${PS4_TWILIGHT_HD_DIR}")
+    add_library(ps4_mod_twilight_hd OBJECT
+        "${_dir}/src/config.cpp" "${_dir}/src/font_override.cpp" "${_dir}/src/item_slot_hooks.cpp"
+        "${_dir}/src/mod.cpp" "${_dir}/src/ui.cpp" "${_dir}/src/update_service.cpp"
+        "${_dir}/src/wolf_touch_icons.cpp")
+    target_compile_features(ps4_mod_twilight_hd PRIVATE cxx_std_20)
+    target_include_directories(ps4_mod_twilight_hd PRIVATE "${_dir}/src" "${CMAKE_SOURCE_DIR}/src")
+    target_link_libraries(ps4_mod_twilight_hd PRIVATE dusklight_mod_feature_game dusklight_game_headers)
+    target_compile_definitions(ps4_mod_twilight_hd PRIVATE
+        mod_meta=twilight_hd_hud_mod_meta mod_ctx=twilight_hd_hud_mod_ctx
+        mod_initialize=twilight_hd_hud_mod_initialize mod_update=twilight_hd_hud_mod_update
+        mod_shutdown=twilight_hd_hud_mod_shutdown)
+    target_link_libraries(${target} PRIVATE ps4_mod_twilight_hd)
+    target_sources(${target} PRIVATE "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/static_mods.cpp")
+    target_compile_definitions(${target} PRIVATE PS4_MOD_TWILIGHT_HD=1)
+endfunction()
+
+# funchook on the PS4: ps4/funchook_ps4.c replaces its Unix layer (no /proc maps, no libdl).
+function(ps4_adapt_funchook)
+    if (NOT TARGET funchook-static)
+        return()
+    endif ()
+    get_target_property(_funchook_dir funchook-static SOURCE_DIR)
+    set_source_files_properties("${_funchook_dir}/src/funchook_unix.c"
+        TARGET_DIRECTORY funchook-static PROPERTIES HEADER_FILE_ONLY ON)
+    target_sources(funchook-static PRIVATE "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/funchook_ps4.c")
+    target_include_directories(funchook-static PRIVATE "${_funchook_dir}/src")
+    get_target_property(_funchook_libs funchook-static LINK_LIBRARIES)
+    list(REMOVE_ITEM _funchook_libs dl)
+    set_target_properties(funchook-static PROPERTIES LINK_LIBRARIES "${_funchook_libs}")
+    get_target_property(_funchook_interface funchook-static INTERFACE_LINK_LIBRARIES)
+    if (_funchook_interface)
+        list(TRANSFORM _funchook_interface REPLACE "^dl$" "")
+        list(TRANSFORM _funchook_interface REPLACE "^\\$<LINK_ONLY:dl>$" "")
+        list(REMOVE_ITEM _funchook_interface "")
+        set_target_properties(funchook-static PROPERTIES INTERFACE_LINK_LIBRARIES "${_funchook_interface}")
+    endif ()
+endfunction()
diff --git a/ps4/crash.cpp b/ps4/crash.cpp
new file mode 100644
index 00000000000..c2db97180b2
--- /dev/null
+++ b/ps4/crash.cpp
@@ -0,0 +1,29 @@
+// SPDX-License-Identifier: MIT
+// The PS4's termination goes through the shell, as on PS5 (ps5/crash.cpp): an unhandled C++
+// exception is logged and the title asks to be closed.
+#include <cstdio>
+#include <exception>
+
+extern "C" int sceSystemServiceLoadExec(const char*, char* const*);
+extern "C" int sceKernelUsleep(unsigned int);
+
+namespace borealis::crash {
+void install() {
+    std::set_terminate([] {
+        const char* what = "none active (std::terminate called directly)";
+        if (auto current = std::current_exception()) {
+            what = "(not a std::exception)";
+            try {
+                std::rethrow_exception(current);
+            } catch (const std::exception& e) {
+                what = e.what();
+            } catch (...) {
+            }
+        }
+        std::fprintf(stderr, "[Dusklight PS4] Unhandled C++ exception: %s; closing through system service\n", what);
+        std::fflush(nullptr);
+        sceSystemServiceLoadExec("exit", nullptr);
+        for (;;) sceKernelUsleep(100000);
+    });
+}
+}
