diff --git a/ps4/tools/embed-manifest.py b/ps4/tools/embed-manifest.py
new file mode 100644
index 00000000000..4c674d192a6
--- /dev/null
+++ b/ps4/tools/embed-manifest.py
@@ -0,0 +1,91 @@
+#!/usr/bin/env python3
+"""Write Dusklight's symbol manifest into the linked PS4 image, without adding sections.
+
+`symgen manifest --embed` appends a section, which the console's loader does not take; the PS4
+build reserves file-backed space instead (ps4_symdb_storage, ps4/symdb_storage.cpp.in). symgen
+needs a GNU build id, which the PS4 link does not make, so it reads a copy carrying one; the image
+itself takes the manifest's build id at run time (src/dusk/mods/manifest.cpp).
+
+    embed-manifest.py --symgen <symgen> --elf <linked image>
+"""
+import argparse
+import hashlib
+import struct
+import subprocess
+import sys
+import tempfile
+from pathlib import Path
+
+DESCRIPTOR = '_ZN4dusk4mods8manifest12_GLOBAL__N_117s_symdbDescriptorE'
+STORAGE = 'ps4_symdb_storage'
+DESCRIPTOR_MAGIC = 0x52444842444d5953  # "SYMDBHDR"
+
+
+def symbols(elf):
+    out = subprocess.run(['llvm-nm-21', '--defined-only', '-S', str(elf)], check=True,
+                         capture_output=True, text=True).stdout
+    found = {}
+    for line in out.splitlines():
+        parts = line.split()
+        if len(parts) == 4 and parts[3] in (DESCRIPTOR, STORAGE):
+            found[parts[3]] = (int(parts[0], 16), int(parts[1], 16))
+    missing = {DESCRIPTOR, STORAGE} - found.keys()
+    if missing:
+        sys.exit(f'embed-manifest: {elf} lacks {", ".join(sorted(missing))}')
+    return found
+
+
+def file_offset(elf, vaddr, size):
+    out = subprocess.run(['llvm-readelf-21', '-lW', str(elf)], check=True,
+                         capture_output=True, text=True).stdout
+    for line in out.splitlines():
+        parts = line.split()
+        if parts and parts[0] == 'LOAD':
+            offset, start, filesz = int(parts[1], 16), int(parts[2], 16), int(parts[4], 16)
+            if start <= vaddr and vaddr + size <= start + filesz:
+                return offset + (vaddr - start)
+    sys.exit(f'embed-manifest: {vaddr:#x}+{size:#x} is not file-backed in a loaded segment')
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    parser.add_argument('--symgen', type=Path, required=True)
+    parser.add_argument('--elf', type=Path, required=True)
+    args = parser.parse_args()
+
+    found = symbols(args.elf)
+    descriptor_vaddr, descriptor_size = found[DESCRIPTOR]
+    storage_vaddr, storage_size = found[STORAGE]
+    descriptor_offset = file_offset(args.elf, descriptor_vaddr, descriptor_size)
+    storage_offset = file_offset(args.elf, storage_vaddr, storage_size)
+
+    image = bytearray(args.elf.read_bytes())
+    magic = struct.unpack_from('<Q', image, descriptor_offset)[0]
+    if magic != DESCRIPTOR_MAGIC:
+        sys.exit(f'embed-manifest: no descriptor at {descriptor_offset:#x} (found {magic:#x})')
+
+    with tempfile.TemporaryDirectory() as temporary:
+        temp = Path(temporary)
+        build_id = hashlib.sha1(image).digest()
+        note = temp / 'build-id.note'
+        note.write_bytes(struct.pack('<III', 4, len(build_id), 3) + b'GNU\0' + build_id)
+        copy = temp / 'image-with-build-id'
+        subprocess.run(['llvm-objcopy-21', '--add-section', f'.note.gnu.build-id={note}',
+                        str(args.elf), str(copy)], check=True)
+        manifest = temp / 'manifest.bin'
+        subprocess.run([str(args.symgen), '--no-color', '-L', 'warn', 'manifest', '--binary', str(copy),
+                        '-o', str(manifest)], check=True)
+        data = manifest.read_bytes()
+
+    if len(data) > storage_size:
+        sys.exit(f'embed-manifest: the manifest is {len(data)} bytes; raise PS4_SYMDB_BYTES '
+                 f'above {storage_size}')
+    image[storage_offset:storage_offset + storage_size] = data + bytes(storage_size - len(data))
+    struct.pack_into('<QQQ', image, descriptor_offset, DESCRIPTOR_MAGIC, storage_vaddr, len(data))
+    args.elf.write_bytes(image)
+    print(f'embed-manifest: {len(data)} bytes ({len(data) * 100 // storage_size}% of the reserved '
+          f'{storage_size}) at {storage_vaddr:#x}')
+
+
+if __name__ == '__main__':
+    main()
diff --git a/ps4/tpak.cpp b/ps4/tpak.cpp
new file mode 100644
index 00000000000..bf0ff115b51
--- /dev/null
+++ b/ps4/tpak.cpp
@@ -0,0 +1,217 @@
+// SPDX-License-Identifier: MIT
+// Texture replacement packs for the PS4 build: <texture_replacements>/<name>.tpak, written by
+// tools/make-tpak.py from a replacement folder. A pack's files are registered with Aurora as
+// virtual replacements and read through a cache of 2 MiB blocks, so the textures of an area, which
+// the pack keeps together, come in with few seeks of the console's hard drive. One file per pack
+// also spares the registration a scan of thousands of files.
+#include "tpak.hpp"
+
+#include <algorithm>
+#include <cstdio>
+#include <cstring>
+#include <list>
+#include <memory>
+#include <mutex>
+#include <string>
+#include <unordered_map>
+#include <unordered_set>
+#include <vector>
+
+#include <fcntl.h>
+#include <unistd.h>
+
+#include <aurora/texture.hpp>
+#include <tracy/Tracy.hpp>
+
+extern "C" {
+size_t sceKernelGetDirectMemorySize(void);
+int32_t sceKernelAllocateDirectMemory(off_t start, off_t end, size_t len, size_t align, int32_t type, off_t* phys);
+int32_t sceKernelMapDirectMemory(void** addr, size_t len, int32_t prot, int32_t flags, off_t phys, size_t align);
+}
+
+namespace ps4::tpak {
+namespace {
+
+constexpr char Magic[8] = {'D', 'T', 'P', 'A', 'K', 0, 1, 0};
+constexpr uint64_t BlockSize = 2u << 20;
+constexpr size_t Blocks = 128;  // 256 MiB: Castle Town and the fields around it stay cached
+
+class Pack {
+public:
+    ~Pack() {
+        if (m_fd >= 0) close(m_fd);
+    }
+
+    bool open(const std::filesystem::path& path) {
+        m_fd = ::open(path.c_str(), O_RDONLY);
+        if (m_fd < 0) return false;
+        uint8_t header[64];
+        if (pread(m_fd, header, sizeof(header), 0) != ssize_t(sizeof(header)) ||
+            std::memcmp(header, Magic, sizeof(Magic)) != 0)
+            return false;
+        uint32_t count;
+        uint64_t indexOffset, indexSize;
+        std::memcpy(&count, header + 8, 4);
+        std::memcpy(&indexOffset, header + 16, 8);
+        std::memcpy(&indexSize, header + 24, 8);
+        m_size = uint64_t(lseek(m_fd, 0, SEEK_END));
+        if (indexSize > (64u << 20) || indexOffset > m_size || indexSize > m_size - indexOffset) return false;
+        std::vector<uint8_t> index(indexSize);
+        if (pread(m_fd, index.data(), index.size(), off_t(indexOffset)) != ssize_t(index.size())) return false;
+        for (size_t pos = 0; pos + 18 <= index.size() && m_order.size() < count;) {
+            uint64_t offset, size;
+            uint16_t length;
+            std::memcpy(&offset, &index[pos], 8);
+            std::memcpy(&size, &index[pos + 8], 8);
+            std::memcpy(&length, &index[pos + 16], 2);
+            pos += 18;
+            if (pos + length > index.size() || offset > m_size || size > m_size - offset) return false;
+            std::string name(reinterpret_cast<const char*>(&index[pos]), length);
+            pos += length;
+            m_entries.emplace(name, Entry{offset, size});
+            m_order.push_back(std::move(name));
+        }
+        return m_order.size() == count;
+    }
+
+    const std::vector<std::string>& files() const { return m_order; }
+
+    bool read(const char* path, std::vector<uint8_t>& out) {
+        const auto it = m_entries.find(path);
+        if (it == m_entries.end()) return false;  // e.g. a mip sidecar the pack does not have
+        out.resize(it->second.size);
+        return copy(it->second.offset, out.data(), out.size());
+    }
+
+private:
+    struct Entry {
+        uint64_t offset, size;
+    };
+    struct Slot {
+        uint64_t index = UINT64_MAX;
+        std::list<size_t>::iterator recent;
+    };
+
+    int m_fd = -1;
+    uint64_t m_size = 0;
+    std::unordered_map<std::string, Entry> m_entries;
+    std::vector<std::string> m_order;
+    std::mutex m_lock;
+    uint8_t* m_arena = nullptr;
+    std::vector<Slot> m_slots;
+    std::list<size_t> m_recent;  // most recently used first
+    std::unordered_map<uint64_t, size_t> m_cached;
+
+    bool allocate() {
+        off_t phys = 0;
+        void* base = nullptr;
+        const size_t bytes = Blocks * BlockSize;
+        if (sceKernelAllocateDirectMemory(0, off_t(sceKernelGetDirectMemorySize()), bytes, 2u << 20, 0, &phys) == 0 &&
+            sceKernelMapDirectMemory(&base, bytes, 0x3 /* CPU read/write */, 0, phys, 2u << 20) == 0) {
+            m_arena = static_cast<uint8_t*>(base);
+        } else {
+            return false;
+        }
+        m_slots.resize(Blocks);
+        for (size_t i = 0; i < Blocks; ++i) {
+            m_recent.push_back(i);
+            m_slots[i].recent = std::prev(m_recent.end());
+        }
+        return true;
+    }
+
+    const uint8_t* block(uint64_t index) {
+        if (const auto it = m_cached.find(index); it != m_cached.end()) {
+            m_recent.splice(m_recent.begin(), m_recent, m_slots[it->second].recent);
+            return m_arena + it->second * BlockSize;
+        }
+        const size_t number = m_recent.back();
+        Slot& slot = m_slots[number];
+        if (slot.index != UINT64_MAX) m_cached.erase(slot.index);
+        slot.index = UINT64_MAX;
+        uint8_t* data = m_arena + number * BlockSize;
+        const uint64_t start = index * BlockSize;
+        const size_t length = size_t(std::min<uint64_t>(BlockSize, m_size - start));
+        {
+            ZoneScopedN("tex: read 2 MiB of a texture pack");
+            for (size_t done = 0; done < length;) {
+                const ssize_t n = pread(m_fd, data + done, length - done, off_t(start + done));
+                if (n <= 0) return nullptr;
+                done += size_t(n);
+            }
+        }
+        slot.index = index;
+        m_cached[index] = number;
+        m_recent.splice(m_recent.begin(), m_recent, slot.recent);
+        return data;
+    }
+
+    bool copy(uint64_t offset, uint8_t* out, size_t length) {
+        std::lock_guard guard(m_lock);
+        if (m_arena == nullptr && !allocate()) {
+            // No direct memory: read the file directly.
+            return pread(m_fd, out, length, off_t(offset)) == ssize_t(length);
+        }
+        while (length) {
+            const uint8_t* data = block(offset / BlockSize);
+            if (data == nullptr) return false;
+            const size_t within = size_t(offset % BlockSize);
+            const size_t n = std::min<size_t>(length, size_t(std::min<uint64_t>(BlockSize, m_size - offset / BlockSize * BlockSize)) - within);
+            std::memcpy(out, data + within, n);
+            offset += n; out += n; length -= n;
+        }
+        return true;
+    }
+};
+
+std::vector<std::unique_ptr<Pack>> s_packs;
+
+bool read_from_pack(void* userData, const char* path, std::vector<uint8_t>& outBytes) {
+    return static_cast<Pack*>(userData)->read(path, outBytes);
+}
+
+bool is_sidecar_mip(const std::string& name) {
+    const size_t dot = name.rfind('.');
+    size_t end = dot == std::string::npos ? name.size() : dot, digits = end;
+    while (digits > 0 && name[digits - 1] >= '0' && name[digits - 1] <= '9') --digits;
+    return digits < end && digits >= 4 && name.compare(digits - 4, 4, "_mip") == 0;
+}
+
+}  // namespace
+
+void close_packs() { s_packs.clear(); }
+
+std::vector<std::filesystem::path> register_packs(const std::filesystem::path& root, int32_t priority,
+    aurora::texture::ReplacementGroup& group) {
+    std::vector<std::filesystem::path> covered;
+    std::error_code error;
+    for (const auto& entry : std::filesystem::directory_iterator(root, error)) {
+        if (!entry.is_regular_file(error) || entry.path().extension() != ".tpak") continue;
+        auto pack = std::make_unique<Pack>();
+        if (!pack->open(entry.path())) {
+            std::fprintf(stderr, "[tpak] %s: not a texture pack\n", entry.path().c_str());
+            continue;
+        }
+        size_t registered = 0;
+        std::unordered_set<std::string> names;
+        for (const auto& file : pack->files()) {
+            const std::string name = file.substr(file.rfind('/') + 1);
+            std::string lower = name;
+            std::transform(lower.begin(), lower.end(), lower.begin(), [](unsigned char c) { return std::tolower(c); });
+            if (is_sidecar_mip(name) || !names.insert(lower).second) continue;
+            const auto registration = aurora::texture::register_virtual_replacement(
+                file, {.read = read_from_pack, .userData = pack.get()}, {.priority = priority});
+            if (registration.id != 0) {
+                group.registrations.push_back(registration);
+                ++registered;
+            }
+        }
+        std::fprintf(stderr, "[tpak] %s: %zu textures registered from %zu files\n", entry.path().c_str(), registered,
+            pack->files().size());
+        covered.push_back(root / entry.path().stem());
+        s_packs.push_back(std::move(pack));
+    }
+    return covered;
+}
+
+}  // namespace ps4::tpak
