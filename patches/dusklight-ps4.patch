diff --git a/src/dusk/mods/loader/static_module.hpp b/src/dusk/mods/loader/static_module.hpp
new file mode 100644
index 00000000000..26916ea0a20
--- /dev/null
+++ b/src/dusk/mods/loader/static_module.hpp
@@ -0,0 +1,41 @@
+#pragma once
+
+// Code mods linked into the game, for platforms that cannot load libraries (the PS4 build,
+// ps4/Platform.cmake). A package's native library file then holds the module's key as text, and
+// NativeModule resolves the module's exports from its table instead of dlopen/dlsym.
+
+namespace dusk::mods::loader {
+
+struct StaticModuleSymbol {
+    const char* name;
+    void* address;
+};
+
+struct StaticModule {
+    const char* key;
+    const StaticModuleSymbol* symbols;
+    unsigned symbolCount;
+};
+
+// Defined by the platform's list of linked-in mods (ps4/static_mods.cpp).
+const StaticModule* find_static_module(const char* key) noexcept;
+
+inline void* find_static_symbol(const StaticModule* module, const char* name) noexcept {
+    if (module == nullptr) {
+        return nullptr;
+    }
+    for (unsigned i = 0; i < module->symbolCount; ++i) {
+        const char* a = module->symbols[i].name;
+        const char* b = name;
+        while (*a != '\0' && *a == *b) {
+            ++a;
+            ++b;
+        }
+        if (*a == *b) {
+            return module->symbols[i].address;
+        }
+    }
+    return nullptr;
+}
+
+}  // namespace dusk::mods::loader
