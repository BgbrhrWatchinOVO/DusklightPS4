+namespace {
+
+// Frame statistics, thread CPU time and the scene timeline: on whenever the profiler runs. Zones
+// (g_enabled) and the sampler cost the FIFO thread a fifth of its time and are on only with
+// /data/dusklight-ps4/prof.
+std::atomic<bool> g_stats{false};
+
+std::atomic<Site*> s_sites{nullptr};
+std::atomic<uint64_t> s_lastFrame{0};
+std::atomic<uint64_t> s_frames{0};
+std::atomic<uint64_t> s_frameTicks{0};
+std::atomic<uint64_t> s_frameMax{0};
+std::atomic<uint64_t> s_mainCpuNs{0};    // the main thread's CPU time, sampled at frame marks
+std::atomic<uint32_t> s_mainCpuMask{0};  // cores the main thread was seen on
+double s_tscPerMs = 1.6e6;
+unsigned s_pgoSeconds = 0;
+uint64_t s_startTicks = 0;
+
+constexpr double HitchMs = 50.0;
+std::atomic<uint64_t> s_frames20{0};  // frames over 20 ms this second
+std::atomic<uint64_t> s_frames33{0};  // frames over 33.4 ms (a missed second vblank) this second
+
+// Threads that report their own CPU time (ps4prof_thread_busy): the main thread, aurora's render
+// and FIFO threads, audio, texture and pipeline workers, the display's flip thread.
+struct Sample {
+    uint64_t rip;    // where the thread was
+    uint64_t stack;  // the word at the top of its stack: a leaf function's return address
+    uint64_t ticks;
+};
+constexpr size_t SampleRing = 8192;  // ~8 s at the sampling rate; the reporter drains it each second
+
+struct ThreadRecord {
+    const char* name;
+    std::atomic<uint64_t> cpuNs{0};
+    std::atomic<ThreadRecord*> next{nullptr};
+    uint64_t secondCpu = 0;  // the reporter's: CPU time at the last second and summary
+    uint64_t summaryCpu = 0;
+    // Sampled threads (sampled_thread_id): the thread, its samples (written by its own signal
+    // handler only) and how far the reporter has read them.
+    pthread_t thread{};
+    int sampleId = -1;
+    Sample* samples = nullptr;
+    std::atomic<uint64_t> sampleWrite{0};
+    uint64_t sampleRead = 0;
+};
+std::atomic<ThreadRecord*> s_threads{nullptr};
+thread_local ThreadRecord* t_threadRecord = nullptr;
+thread_local uint64_t t_threadSampled = 0;
+constexpr uint64_t SlowSecondFrames = 52;
+
+// The sampler: SIGPROF to the main, render and FIFO threads about 1000 times a second each. The
+// handler notes where the thread was; the reporter appends the samples to samples.bin, which
+// tools/ps4-samples.py symbolizes - where the time goes inside functions without zones, Dawn and
+// Mesa included. /data/dusklight-ps4/nosample turns it off.
+constexpr int SigProf = 27;          // FreeBSD (and Linux) numbering
+constexpr int SaSiginfo = 0x40;      // FreeBSD values: the musl headers may carry Linux ones
+constexpr int SaRestart = 0x02;
+constexpr int McontextOffset = 0x40; // ps4_crashlog.cpp: measured on hardware
+constexpr int RipIndex = 20, RspIndex = 23;
+bool s_sampling = false;
+FILE* s_sampleFile = nullptr;
+
+int sampled_thread_id(const char* name) {
+    static constexpr const char* Names[] = {"main", "aurora render", "gx fifo"};
+    for (int i = 0; i < int(std::size(Names)); ++i) {
+        if (std::strcmp(name, Names[i]) == 0) {
+            return i;
+        }
+    }
+    return -1;
+}
+uint64_t s_secondsSeen = 0;
+constexpr int SummarySeconds = 10;
+
+void atomic_max(std::atomic<uint64_t>& target, uint64_t value) {
+    uint64_t current = target.load(std::memory_order_relaxed);
+    while (value > current && !target.compare_exchange_weak(current, value, std::memory_order_relaxed)) {
+    }
+}
+
+uint64_t thread_cpu_ns() {
+    timespec ts{};
+    if (clock_gettime(CLOCK_THREAD_CPUTIME_ID, &ts) != 0) {
+        return 0;
+    }
+    return uint64_t(ts.tv_sec) * 1000000000ull + uint64_t(ts.tv_nsec);
+}
+
+uint64_t process_cpu_ns() {
+    rusage usage{};
+    if (getrusage(RUSAGE_SELF, &usage) != 0) {
+        return 0;
+    }
+    auto ns = [](const timeval& tv) { return uint64_t(tv.tv_sec) * 1000000000ull + uint64_t(tv.tv_usec) * 1000ull; };
+    return ns(usage.ru_utime) + ns(usage.ru_stime);
+}
+
+double seconds_since_start() { return double(ticks() - s_startTicks) / (s_tscPerMs * 1000.0); }
+
+// "name 95%, ..." for each reporting thread over the window, updating its mark.
+std::string thread_busy_text(double windowMs, bool summary) {
+    std::string text;
+    for (ThreadRecord* t = s_threads.load(std::memory_order_acquire); t != nullptr;
+         t = t->next.load(std::memory_order_acquire)) {
+        const uint64_t cpu = t->cpuNs.load(std::memory_order_relaxed);
+        uint64_t& mark = summary ? t->summaryCpu : t->secondCpu;
+        const double percent = cpu > mark ? double(cpu - mark) / 1e4 / windowMs : 0.0;
+        mark = cpu;
+        if (percent < 1.0) {
+            continue;
+        }
+        char part[64];
+        std::snprintf(part, sizeof(part), "%s%s %.0f%%", text.empty() ? "" : ", ", t->name, percent);
+        text += part;
+    }
+    return text.empty() ? "-" : text;
+}
+
+const char* short_file(const char* file) {
+    const char* slash = std::strrchr(file, '/');
+    return slash != nullptr ? slash + 1 : file;
+}
+
+struct Snapshot {
+    uint64_t calls = 0, total = 0, self = 0, mainSelf = 0;
+};
+
+struct Row {
+    const Site* site;
+    uint64_t calls, total, self, max, mainSelf;
+};
+
+Snapshot snapshot(const Site* site) {
+    return {site->calls.load(std::memory_order_relaxed), site->total.load(std::memory_order_relaxed),
+        site->self.load(std::memory_order_relaxed), site->mainSelf.load(std::memory_order_relaxed)};
+}
+
+void print_rows(std::vector<Row>& rows, size_t limit, double windowMs, uint64_t frames) {
+    std::sort(rows.begin(), rows.end(), [](const Row& a, const Row& b) { return a.self > b.self; });
+    for (size_t i = 0; i < rows.size() && i < limit; ++i) {
+        const Row& r = rows[i];
+        const double selfMs = double(r.self) / s_tscPerMs;
+        if (selfMs < windowMs * 0.002) {
+            break;
+        }
+        char label[160];
+        if (r.site->name != nullptr) {
+            std::snprintf(label, sizeof(label), "%s", r.site->name);
+        } else {
+            std::snprintf(label, sizeof(label), "%s (%s:%d)", r.site->function, short_file(r.site->file), r.site->line);
+        }
+        std::fprintf(stderr,
+            "[prof]   %7.1f ms self %7.1f ms total %7" PRIu64 " calls  max %6.1f ms  %5.2f ms/frame  main %5.2f ms/frame  %s\n",
+            selfMs, double(r.total) / s_tscPerMs, r.calls, double(r.max) / s_tscPerMs,
+            frames != 0 ? selfMs / double(frames) : 0.0,
+            frames != 0 ? double(r.mainSelf) / s_tscPerMs / double(frames) : 0.0, label);
+    }
+}
+
+thread_local ThreadRecord* t_sampleRecord = nullptr;
+
+void sample_handler(int, siginfo_t*, void* context) {
+    ThreadRecord* record = t_sampleRecord;
+    if (record == nullptr) {
+        return;
+    }
+    const auto* regs = reinterpret_cast<const uint64_t*>(static_cast<const char*>(context) + McontextOffset);
+    const uint64_t rsp = regs[RspIndex];
+    const uint64_t n = record->sampleWrite.load(std::memory_order_relaxed);
+    Sample& sample = record->samples[n % SampleRing];
+    sample.rip = regs[RipIndex];
+    sample.stack = rsp != 0 ? *reinterpret_cast<const uint64_t*>(rsp) : 0;
+    sample.ticks = ticks();
+    record->sampleWrite.store(n + 1, std::memory_order_release);
+}
+
+void sampler() {
+    for (;;) {
+        std::this_thread::sleep_for(std::chrono::milliseconds(1));
+        for (ThreadRecord* t = s_threads.load(std::memory_order_acquire); t != nullptr;
+             t = t->next.load(std::memory_order_acquire)) {
+            if (t->samples != nullptr) {
+                pthread_kill(t->thread, SigProf);
+            }
+        }
+    }
+}
+
+// Appends the samples taken since the last call: per sample a u32 millisecond since the start,
+// the thread (u32: 0 main, 1 render, 2 FIFO), and the two addresses relative to .text (ELF
+// addresses when they are in the eboot's code).
+void write_samples() {
+    if (s_sampleFile == nullptr) {
+        return;
+    }
+    const uint64_t text = reinterpret_cast<uintptr_t>(__text_start);
+    for (ThreadRecord* t = s_threads.load(std::memory_order_acquire); t != nullptr;
+         t = t->next.load(std::memory_order_acquire)) {
+        if (t->samples == nullptr) {
+            continue;
+        }
+        const uint64_t end = t->sampleWrite.load(std::memory_order_acquire);
+        uint64_t n = std::max(t->sampleRead, end > SampleRing ? end - SampleRing : 0);
+        for (; n < end; ++n) {
+            const Sample& sample = t->samples[n % SampleRing];
+            struct {
+                uint32_t ms, thread;
+                uint64_t rip, stack;
+            } out{uint32_t(double(sample.ticks - s_startTicks) / s_tscPerMs), uint32_t(t->sampleId),
+                sample.rip - text, sample.stack - text};
+            std::fwrite(&out, sizeof(out), 1, s_sampleFile);
+        }
+        t->sampleRead = end;
+    }
+    std::fflush(s_sampleFile);
+}
+
+void reporter() {
+    std::unordered_map<const Site*, Snapshot> second, summary;
+    std::unordered_map<const Site*, uint64_t> summaryMax;
+    uint64_t summaryFrames = 0, summaryFrameTicks = 0, summaryFrameMax = 0, summaryHitches = 0;
+    uint64_t summaryMainCpu = s_mainCpuNs.load(), summaryProcessCpu = process_cpu_ns();
+    uint64_t summaryGpuBusy = 0, summaryGpuSpan = 0;
+    uint64_t secondGpuBusy = 0, secondGpuSpan = 0;
+    if (ac_ps4_get_gpu_busy != nullptr) {
+        ac_ps4_get_gpu_busy(&summaryGpuBusy, &summaryGpuSpan);
+    }
+    uint64_t summaryStart = ticks();
+    int secondsInSummary = 0;
+
+    for (;;) {
+        std::this_thread::sleep_for(std::chrono::seconds(1));
+        const uint64_t frames = s_frames.exchange(0, std::memory_order_relaxed);
+        const uint64_t frameTicks = s_frameTicks.exchange(0, std::memory_order_relaxed);
+        const uint64_t frameMax = s_frameMax.exchange(0, std::memory_order_relaxed);
+        const double frameMaxMs = double(frameMax) / s_tscPerMs;
+        const bool hitch = frameMaxMs >= HitchMs || frames == 0;
+        const uint64_t frames20 = s_frames20.exchange(0, std::memory_order_relaxed);
+        const uint64_t frames33 = s_frames33.exchange(0, std::memory_order_relaxed);
+        uint64_t gpuBusyNow = 0, gpuSpanNow = 0;
+        if (ac_ps4_get_gpu_busy != nullptr) {
+            ac_ps4_get_gpu_busy(&gpuBusyNow, &gpuSpanNow);
+        }
+        const double gpuSecond = gpuSpanNow > secondGpuSpan
+            ? 100.0 * double(gpuBusyNow - secondGpuBusy) / double(gpuSpanNow - secondGpuSpan) : 0.0;
+        secondGpuBusy = gpuBusyNow;
+        secondGpuSpan = gpuSpanNow;
+        const std::string threads = thread_busy_text(1000.0, false);
+        // A second well below the display's rate without a single long frame: what slowed it down.
+        const bool slow = !hitch && frames < SlowSecondFrames && s_secondsSeen > 10;
+        ++s_secondsSeen;
+
+        std::vector<Row> rows;
+        for (Site* site = s_sites.load(std::memory_order_acquire); site != nullptr;
+             site = site->next.load(std::memory_order_acquire)) {
+            const Snapshot now = snapshot(site);
+            const uint64_t max = site->max.exchange(0, std::memory_order_relaxed);
+            Snapshot& last = second[site];
+            if (now.calls != last.calls) {
+                rows.push_back({site, now.calls - last.calls, now.total - last.total, now.self - last.self, max,
+                    now.mainSelf - last.mainSelf});
+            }
+            last = now;
+            uint64_t& longest = summaryMax[site];
+            longest = std::max(longest, max);
+        }
+
+        summaryFrames += frames;
+        summaryFrameTicks += frameTicks;
+        summaryFrameMax = std::max(summaryFrameMax, frameMax);
+        summaryHitches += hitch ? 1 : 0;
+        if (hitch) {
+            std::fprintf(stderr,
+                "[prof] %9.3f hitch: %" PRIu64 " frames this second (%" PRIu64 " over 20 ms, %" PRIu64
+                " over 33 ms), longest %.1f ms, GPU busy %.0f%%; threads: %s; where the time went:\n",
+                seconds_since_start(), frames, frames20, frames33, frameMaxMs, gpuSecond, threads.c_str());
+            print_rows(rows, 14, 1000.0, frames);
+        } else if (slow) {
+            std::fprintf(stderr,
+                "[prof] %9.3f slow second: %" PRIu64 " frames (%" PRIu64 " over 20 ms, %" PRIu64
+                " over 33 ms), longest %.1f ms, GPU busy %.0f%%; threads: %s; where the time went:\n",
+                seconds_since_start(), frames, frames20, frames33, frameMaxMs, gpuSecond, threads.c_str());
+            print_rows(rows, 12, 1000.0, frames);
+        }
+
+        write_samples();
+#if defined(PS4_PGO_GENERATE)
+        if (++s_pgoSeconds == 15 || s_pgoSeconds % 60 == 0) {
+            ps4_pgo_dump();
+        }
+#endif
+        if (++secondsInSummary < SummarySeconds) {
+            continue;
+        }
+        const uint64_t nowTicks = ticks();
+        const double windowMs = double(nowTicks - summaryStart) / s_tscPerMs;
+        const uint64_t mainCpu = s_mainCpuNs.load(std::memory_order_relaxed);
+        const uint64_t processCpu = process_cpu_ns();
+        uint64_t gpuBusy = 0, gpuSpan = 0;
+        if (ac_ps4_get_gpu_busy != nullptr) {
+            ac_ps4_get_gpu_busy(&gpuBusy, &gpuSpan);
+        }
+        const double gpuPercent = gpuSpan > summaryGpuSpan
+            ? 100.0 * double(gpuBusy - summaryGpuBusy) / double(gpuSpan - summaryGpuSpan) : 0.0;
+        summaryGpuBusy = gpuBusy;
+        summaryGpuSpan = gpuSpan;
+        std::fprintf(stderr,
+            "[prof] %9.3f summary %.1f s: %.1f FPS, frame avg %.2f ms max %.1f ms, %" PRIu64
+            " seconds with hitches; main thread busy %.0f%% (cores seen 0x%02x), process %.2f cores busy, GPU busy %.0f%%\n",
+            seconds_since_start(), windowMs / 1000.0, double(summaryFrames) * 1000.0 / windowMs,
+            summaryFrames != 0 ? double(summaryFrameTicks) / s_tscPerMs / double(summaryFrames) : 0.0,
+            double(summaryFrameMax) / s_tscPerMs, summaryHitches,
+            mainCpu > summaryMainCpu ? double(mainCpu - summaryMainCpu) / 1e4 / windowMs : 0.0,
+            s_mainCpuMask.exchange(0, std::memory_order_relaxed),
+            processCpu > summaryProcessCpu ? double(processCpu - summaryProcessCpu) / 1e6 / windowMs : 0.0,
+            gpuPercent);
+        std::vector<Row> summaryRows;
+        for (Site* site = s_sites.load(std::memory_order_acquire); site != nullptr;
+             site = site->next.load(std::memory_order_acquire)) {
+            const Snapshot now = snapshot(site);
+            Snapshot& last = summary[site];
+            if (now.calls != last.calls) {
+                summaryRows.push_back({site, now.calls - last.calls, now.total - last.total, now.self - last.self,
+                    summaryMax[site], now.mainSelf - last.mainSelf});
+            }
+            last = now;
+        }
+        summaryMax.clear();
+        std::fprintf(stderr, "[prof] %9.3f threads over %.1f s: %s\n", seconds_since_start(), windowMs / 1000.0,
+            thread_busy_text(windowMs, true).c_str());
+        if (ac_ps4_get_memory != nullptr) {
+            uint64_t garlic = 0, onion = 0, buffers = 0;
+            ac_ps4_get_memory(&garlic, &onion, &buffers);
+            std::fprintf(stderr, "[prof] %9.3f GPU memory: %.1f MiB VRAM (garlic), %.1f MiB onion, %" PRIu64 " buffers\n",
+                seconds_since_start(), double(garlic) / 1048576.0, double(onion) / 1048576.0, buffers);
+        }
+        print_rows(summaryRows, 20, windowMs, summaryFrames);
+        summaryFrames = summaryFrameTicks = summaryFrameMax = summaryHitches = 0;
+        summaryMainCpu = mainCpu;
+        summaryProcessCpu = processCpu;
+        summaryStart = nowTicks;
+        secondsInSummary = 0;
+    }
+}
+
+// The core clock: a chain of dependent adds takes one cycle each. The best of three runs of 64M
+// adds (~30-40 ms each), against the TSC. A PS4 Pro runs 1.6 GHz, or 2.1 GHz in Boost Mode.
+double measure_core_mhz() {
+    double best = 0.0;
+    for (int run = 0; run < 3; ++run) {
+        uint64_t value = 0;
+        const uint64_t begin = ticks();
+        for (uint32_t i = 0; i < 1000000; ++i) {
+            __asm__ volatile(".rept 64\n\taddq $1, %0\n\t.endr" : "+r"(value));
+        }
+        const double ms = double(ticks() - begin) / s_tscPerMs;
+        best = std::max(best, 64.0 * 1000000.0 / (ms * 1000.0));
+    }
+    return best;
+}
+
+}  // namespace
+
+void Site::enlist() noexcept {
+    bool expected = false;
+    if (!enlisted.compare_exchange_strong(expected, true, std::memory_order_acq_rel)) {
+        return;
+    }
+    Site* head = s_sites.load(std::memory_order_relaxed);
+    do {
+        next.store(head, std::memory_order_relaxed);
+    } while (!s_sites.compare_exchange_weak(head, this, std::memory_order_release, std::memory_order_relaxed));
+}
+
+void frame_mark() noexcept {
+    if (!g_stats.load(std::memory_order_relaxed)) {
+        return;
+    }
+    t_mainThread = true;
+    const uint64_t now = ticks();
+    const uint64_t previous = s_lastFrame.exchange(now, std::memory_order_relaxed);
+    if (previous == 0) {
+        return;
+    }
+    const uint64_t elapsed = now - previous;
+    const uint64_t frame = s_frames.fetch_add(1, std::memory_order_relaxed);
+    if (double(elapsed) > 20.0 * s_tscPerMs) {
+        s_frames20.fetch_add(1, std::memory_order_relaxed);
+    }
+    if (double(elapsed) > 33.4 * s_tscPerMs) {
+        s_frames33.fetch_add(1, std::memory_order_relaxed);
+    }
+    ps4prof_thread_busy("main");
+    s_frameTicks.fetch_add(elapsed, std::memory_order_relaxed);
+    atomic_max(s_frameMax, elapsed);
+    if (frame % 30 == 0) {
+        if (const uint64_t cpu = thread_cpu_ns(); cpu != 0) {
+            s_mainCpuNs.store(cpu, std::memory_order_relaxed);
+        }
+        const int core = sceKernelGetCurrentCpu();
+        if (core >= 0 && core < 32) {
+            s_mainCpuMask.fetch_or(1u << core, std::memory_order_relaxed);
+        }
+    }
+}
+
+// Zones for code built outside the game (ps4prof_c.h): sites made on first use, scopes kept on a
+// per-thread stack, so they nest with the game's zones.
+namespace {
+constexpr int CZoneDepth = 32;
+alignas(Scope) thread_local unsigned char t_cScopes[CZoneDepth][sizeof(Scope)];
+thread_local int t_cDepth = 0;
+std::mutex s_cSiteLock;
+}  // namespace
+
+extern "C" void* ps4prof_enter(void** site, const char* name) {
+    if (!g_enabled.load(std::memory_order_relaxed) || t_cDepth >= CZoneDepth) {
+        return nullptr;
+    }
+    if (*site == nullptr) {
+        std::lock_guard lock{s_cSiteLock};
+        if (*site == nullptr) {
+            *site = new Site(name, name, "", 0);
+        }
+    }
+    return new (t_cScopes[t_cDepth++]) Scope(*static_cast<Site*>(*site));
+}
+
+extern "C" void ps4prof_leave(void* zone) {
+    if (zone == nullptr) {
+        return;
+    }
+    static_cast<Scope*>(zone)->~Scope();
+    --t_cDepth;
+}
+
+extern "C" void ps4prof_thread_busy(const char* name) {
+    if (!g_stats.load(std::memory_order_relaxed)) {
+        return;
+    }
+    if (t_threadRecord == nullptr) {
+        auto* record = new ThreadRecord{name};
+        record->thread = pthread_self();
+        record->sampleId = sampled_thread_id(name);
+        if (s_sampling && record->sampleId >= 0) {
+            record->samples = new Sample[SampleRing]();
+            t_sampleRecord = record;
+        }
+        ThreadRecord* head = s_threads.load(std::memory_order_relaxed);
+        do {
+            record->next.store(head, std::memory_order_relaxed);
+        } while (!s_threads.compare_exchange_weak(head, record, std::memory_order_release, std::memory_order_relaxed));
+        t_threadRecord = record;
+    }
+    // At most every 2 ms: a clock_gettime per call.
+    const uint64_t now = ticks();
+    if (double(now - t_threadSampled) < 2.0 * s_tscPerMs) {
+        return;
+    }
+    t_threadSampled = now;
+    if (const uint64_t cpu = thread_cpu_ns(); cpu != 0) {
+        t_threadRecord->cpuNs.store(cpu, std::memory_order_relaxed);
+    }
+}
+
+extern "C" void ps4prof_scene_note(const char* text) noexcept {
+    if (g_stats.load(std::memory_order_relaxed)) {
+        std::fprintf(stderr, "[prof] %9.3f scene: %s\n", seconds_since_start(), text);
+    }
+}
+
+extern "C" void ps4prof_scene_mark(const char* step) noexcept {
+    static const char* s_lastStep = nullptr;
+    static uint64_t s_changeStart = 0;
+    if (!g_stats.load(std::memory_order_relaxed) || step == s_lastStep) {
+        return;
+    }
+    const uint64_t now = ticks();
+    if (std::strcmp(step, "scene change") == 0 || s_changeStart == 0) {
+        s_changeStart = now;
+    }
+    s_lastStep = step;
+    std::fprintf(stderr, "[prof] %9.3f scene: %s (+%.0f ms)\n", seconds_since_start(), step,
+        double(now - s_changeStart) / s_tscPerMs);
+}
+
+void start() noexcept {
+    const uint64_t frequency = sceKernelGetTscFrequency();
+    if (frequency != 0) {
+        s_tscPerMs = double(frequency) / 1000.0;
+    }
+    s_startTicks = ticks();
+    struct stat st;
+    const bool zones = stat("/data/dusklight-ps4/prof", &st) == 0;
+    std::fprintf(stderr,
+        "[prof] profiler on (%s): TSC %.0f MHz, core clock ~%.0f MHz, %u hardware threads, main thread on core %d\n",
+        zones ? "zones and sampler: /data/dusklight-ps4/prof" : "frame statistics only", s_tscPerMs / 1000.0,
+        measure_core_mhz(), std::thread::hardware_concurrency(), sceKernelGetCurrentCpu());
+    if (zones && stat("/data/dusklight-ps4/nosample", &st) != 0) {
+        s_sampleFile = std::fopen("/data/dusklight-ps4/samples.bin", "wb");
+    }
+    if (s_sampleFile != nullptr) {
+        std::fwrite("DSMP\1\0\0\0", 8, 1, s_sampleFile);
+        struct sigaction action;
+        std::memset(&action, 0, sizeof(action));
+        void (*handler)(int, siginfo_t*, void*) = sample_handler;
+        std::memcpy(&action, &handler, sizeof(handler));  // the handler union's member names vary
+        action.sa_flags = SaSiginfo | SaRestart;
+        sigemptyset(&action.sa_mask);
+        s_sampling = sigaction(SigProf, &action, nullptr) == 0;
+        std::fprintf(stderr, "[prof] sampler %s: main, render and FIFO threads to samples.bin\n",
+            s_sampling ? "on" : "unavailable");
+    }
+    g_stats.store(true, std::memory_order_relaxed);
+    g_enabled.store(zones, std::memory_order_relaxed);
+    std::thread(reporter).detach();
+    if (s_sampling) {
+        std::thread(sampler).detach();
+    }
+}
+
+}  // namespace ps4prof
diff --git a/ps4/prof/ps4_profiler.hpp b/ps4/prof/ps4_profiler.hpp
new file mode 100644
index 00000000000..1c0d8f95a29
--- /dev/null
+++ b/ps4/prof/ps4_profiler.hpp
@@ -0,0 +1,103 @@
+// SPDX-License-Identifier: MIT
+// A small in-game profiler for the PS4 build: the code's Tracy zones (ZoneScoped, ZoneScopedN)
+// and FrameMark feed it (ps4/prof/tracy/Tracy.hpp), and a reporter thread writes where the time
+// went to the log (ps4/prof/ps4_profiler.cpp). Tracy itself needs a connected viewer.
+//
+// A zone costs two TSC reads and a few atomic adds; while profiling is off it costs a load and a
+// branch.
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+
+namespace ps4prof {
+
+struct Site {
+    const char* name;  // ZoneScopedN's name, or null
+    const char* function;
+    const char* file;
+    int line;
+    std::atomic<uint64_t> calls{0};
+    std::atomic<uint64_t> total{0};  // TSC ticks including nested zones
+    std::atomic<uint64_t> self{0};   // TSC ticks without nested zones
+    std::atomic<uint64_t> max{0};    // longest single call since the reporter last looked
+    std::atomic<uint64_t> mainSelf{0};  // self ticks on the main thread (the one marking frames)
+    std::atomic<Site*> next{nullptr};
+    std::atomic<bool> enlisted{false};
+
+    constexpr Site(const char* name_, const char* function_, const char* file_, int line_) noexcept
+    : name(name_), function(function_), file(file_), line(line_) {}
+    void enlist() noexcept;
+};
+
+extern std::atomic<bool> g_enabled;
+
+inline uint64_t ticks() noexcept { return __builtin_ia32_rdtsc(); }
+
+struct Scope;
+inline thread_local Scope* t_current = nullptr;
+inline thread_local bool t_mainThread = false;
+
+struct Scope {
+    Site* site = nullptr;
+    Scope* parent;
+    uint64_t start;
+    uint64_t nested;
+
+    explicit Scope(Site& s) noexcept {
+        if (!g_enabled.load(std::memory_order_relaxed)) {
+            return;
+        }
+        if (!s.enlisted.load(std::memory_order_acquire)) {
+            s.enlist();
+        }
+        site = &s;
+        parent = t_current;
+        nested = 0;
+        t_current = this;
+        start = ticks();
+    }
+    ~Scope() {
+        if (site == nullptr) {
+            return;
+        }
+        const uint64_t elapsed = ticks() - start;
+        site->calls.fetch_add(1, std::memory_order_relaxed);
+        site->total.fetch_add(elapsed, std::memory_order_relaxed);
+        site->self.fetch_add(elapsed - nested, std::memory_order_relaxed);
+        if (t_mainThread) {
+            site->mainSelf.fetch_add(elapsed - nested, std::memory_order_relaxed);
+        }
+        uint64_t longest = site->max.load(std::memory_order_relaxed);
+        while (elapsed > longest &&
+               !site->max.compare_exchange_weak(longest, elapsed, std::memory_order_relaxed)) {
+        }
+        t_current = parent;
+        if (parent != nullptr) {
+            parent->nested += elapsed;
+        }
+    }
+    Scope(const Scope&) = delete;
+    Scope& operator=(const Scope&) = delete;
+};
+
+// One game frame ended (FrameMark).
+void frame_mark() noexcept;
+// Starts the reporter; profiling is on from then on.
+void start() noexcept;
+// Logs a step of a scene change, with the time since the change was requested ("scene change"
+// starts one); a step repeated as its phase polls is logged once.
+extern "C" void ps4prof_scene_mark(const char* step) noexcept;
+// A line in the scene timeline (stage and room names).
+extern "C" void ps4prof_scene_note(const char* text) noexcept;
+// Called from a thread's loop: its CPU time shows as "name N%" in slow seconds and summaries.
+// Samples at most every 2 ms.
+extern "C" void ps4prof_thread_busy(const char* name);
+
+}  // namespace ps4prof
+
+#define PS4PROF_CAT2(a, b) a##b
+#define PS4PROF_CAT(a, b) PS4PROF_CAT2(a, b)
+#define PS4PROF_ZONE(name)                                                                      \
+    static ::ps4prof::Site PS4PROF_CAT(ps4prof_site_, __LINE__){name, __func__, __FILE__, __LINE__}; \
+    ::ps4prof::Scope PS4PROF_CAT(ps4prof_scope_, __LINE__) { PS4PROF_CAT(ps4prof_site_, __LINE__) }
