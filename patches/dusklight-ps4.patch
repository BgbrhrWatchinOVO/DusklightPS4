diff --git a/ps4/disc/raw_disc.cpp b/ps4/disc/raw_disc.cpp
new file mode 100644
index 00000000000..7a1263b1225
--- /dev/null
+++ b/ps4/disc/raw_disc.cpp
@@ -0,0 +1,394 @@
+// SPDX-License-Identifier: MIT
+// Application disc backend for raw GameCube ISOs and decrypted Wii ISOs, the PS5 port's
+// ps5/disc/raw_gamecube.cpp extended to Wii discs. Implements the nod C API subset used by
+// Aurora/Borealis; no compressed images.
+//
+// A Wii image must have its partition data decrypted beforehand, so the console needs no keys:
+// `nodtool convert --decrypt <disc> <out.iso>` (github.com/encounter/nod) writes one. Its data
+// partition keeps the disc's layout: clusters of 0x8000 bytes, each a 0x400-byte hash block and
+// 0x7C00 bytes of data, and boot header, DOL, FST and file offsets stored shifted right by 2.
+#include <nod.h>
+#include <tracy/Tracy.hpp>
+#include <algorithm>
+#include <array>
+#include <atomic>
+#include <chrono>
+#include <cstdlib>
+#include <cstring>
+#include <limits>
+#include <list>
+#include <memory>
+#include <mutex>
+#include <new>
+#include <string>
+#include <unordered_map>
+#include <vector>
+
+#if defined(__ORBIS__)
+extern "C" {
+size_t sceKernelGetDirectMemorySize(void);
+int32_t sceKernelAllocateDirectMemory(off_t start, off_t end, size_t len, size_t align, int32_t type, off_t* phys);
+int32_t sceKernelMapDirectMemory(void** addr, size_t len, int32_t prot, int32_t flags, off_t phys, size_t align);
+}
+#endif
+
+namespace {
+thread_local std::string error;
+NodResult fail(NodResult code, const char* message) { error = message; return code; }
+uint32_t be32(const uint8_t* p) {
+    return uint32_t(p[0]) << 24 | uint32_t(p[1]) << 16 | uint32_t(p[2]) << 8 | p[3];
+}
+constexpr uint32_t GcnMagic = 0xc2339f3d, WiiMagic = 0x5d1c9ea3;
+
+// When the image was last read from the drive: texture replacement loads wait while the game
+// reads (ps4_disc_busy_until_ns), so one drive does not seek between both during a scene change.
+std::atomic<uint64_t> g_busyUntilNs{0};
+uint64_t now_ns() {
+    return uint64_t(std::chrono::duration_cast<std::chrono::nanoseconds>(
+        std::chrono::steady_clock::now().time_since_epoch()).count());
+}
+constexpr uint64_t BusyWindowNs = 250'000'000;
+
+// The image in 1 MiB blocks, the most recently used kept, for all opens of the image (the game,
+// its inspections): the console's C library splits each stream read into many small system
+// calls, so a few large reads beat many small ones (an area's archives, the FST and the DOL are
+// read in 0x7C00-byte cluster pieces), and a hard drive read is ~50 ms. 256 MiB from the
+// console's direct memory keep the areas of a town as one walks between them.
+class BlockCache {
+public:
+    static constexpr uint64_t BlockSize = 1 << 20;
+
+    // Copies [offset, offset + length) of the image (`size` bytes, read with `stream`).
+    bool copy(const NodDiscStream& stream, uint64_t size, uint64_t offset, uint8_t* out, size_t length) {
+        std::lock_guard guard(m_lock);
+        if (m_slots.empty() && !allocate()) return false;
+        while (length) {
+            const uint8_t* data = block(stream, size, offset / BlockSize);
+            if (data == nullptr) return false;
+            const size_t within = size_t(offset % BlockSize);
+            const size_t n = size_t(std::min<uint64_t>(length, std::min<uint64_t>(BlockSize, size - offset / BlockSize * BlockSize) - within));
+            std::memcpy(out, data + within, n);
+            offset += n; out += n; length -= n;
+        }
+        return true;
+    }
+
+private:
+    struct Slot {
+        uint64_t size = 0, index = 0;  // the image's size and the block's index; size 0: free
+        std::list<size_t>::iterator recent;
+    };
+    std::mutex m_lock;
+    uint8_t* m_arena = nullptr;
+    std::vector<Slot> m_slots;
+    std::list<size_t> m_recent;  // slot numbers, most recently used first
+    std::unordered_map<uint64_t, size_t> m_index;
+
+    static uint64_t key(uint64_t size, uint64_t index) { return index ^ (size * 0x9E3779B97F4A7C15ull); }
+
+    bool allocate() {
+        size_t slots = 0;
+#if defined(__ORBIS__)
+        constexpr size_t DirectBytes = 256u << 20;
+        off_t phys = 0;
+        void* base = nullptr;
+        if (sceKernelAllocateDirectMemory(0, off_t(sceKernelGetDirectMemorySize()), DirectBytes, 2u << 20, 0, &phys) == 0 &&
+            sceKernelMapDirectMemory(&base, DirectBytes, 0x3 /* CPU read/write */, 0, phys, 2u << 20) == 0) {
+            m_arena = static_cast<uint8_t*>(base);
+            slots = DirectBytes / BlockSize;
+        }
+#endif
+        if (m_arena == nullptr) {
+            slots = 64;
+            m_arena = static_cast<uint8_t*>(std::malloc(slots * BlockSize));
+            if (m_arena == nullptr) return false;
+        }
+        m_slots.resize(slots);
+        for (size_t i = 0; i < slots; ++i) {
+            m_recent.push_back(i);
+            m_slots[i].recent = std::prev(m_recent.end());
+        }
+        return true;
+    }
+
+    const uint8_t* block(const NodDiscStream& stream, uint64_t size, uint64_t index) {
+        if (const auto it = m_index.find(key(size, index)); it != m_index.end()) {
+            Slot& slot = m_slots[it->second];
+            if (slot.size == size && slot.index == index) {
+                m_recent.splice(m_recent.begin(), m_recent, slot.recent);
+                return m_arena + it->second * BlockSize;
+            }
+        }
+        // The least recently used slot takes the block.
+        const size_t number = m_recent.back();
+        Slot& slot = m_slots[number];
+        if (slot.size != 0) m_index.erase(key(slot.size, slot.index));
+        slot.size = 0;
+        uint8_t* data = m_arena + number * BlockSize;
+        const uint64_t start = index * BlockSize;
+        const size_t length = size_t(std::min<uint64_t>(BlockSize, size - start));
+        {
+            ZoneScopedN("disc: read 1 MiB of the image");
+            g_busyUntilNs.store(now_ns() + BusyWindowNs, std::memory_order_relaxed);
+            for (size_t done = 0; done < length;) {
+                const auto n = stream.read_at(stream.user_data, start + done, data + done, length - done);
+                if (n <= 0 || uint64_t(n) > length - done) return nullptr;
+                done += size_t(n);
+            }
+            g_busyUntilNs.store(now_ns() + BusyWindowNs, std::memory_order_relaxed);
+        }
+        slot.size = size;
+        slot.index = index;
+        m_index[key(size, index)] = number;
+        m_recent.splice(m_recent.begin(), m_recent, slot.recent);
+        return data;
+    }
+};
+BlockCache g_cache;
+constexpr uint64_t WiiCluster = 0x8000, WiiClusterHash = 0x400, WiiClusterData = 0x7c00;
+constexpr uint64_t WiiPartitionInfo = 0x40000;
+struct Entry { uint32_t name; uint64_t offset; uint32_t size; bool directory; };
+struct Disc {
+    NodDiscStream stream{};
+    uint64_t size{};
+    NodDiscHeader header{};
+    std::vector<uint8_t> fst, dol;
+    std::vector<Entry> entries;
+    bool ownsStream{};
+    // A Wii disc's data partition: where its clusters start in the image, and its bytes of data.
+    bool wii{};
+    uint64_t dataStart{}, dataSize{};
+    const char* reason = "Requires a raw GameCube ISO or a decrypted Wii ISO with bounded FST/DOL";
+    ~Disc() { if (ownsStream) stream.close(stream.user_data); }
+    // Bytes of the image itself.
+    bool exact(uint64_t offset, uint8_t* out, size_t length) {
+        if (offset > size || length > size - offset) return false;
+        return g_cache.copy(stream, size, offset, out, length);
+    }
+    // Bytes of the data partition: the image for GameCube, the clusters' data for Wii.
+    uint64_t partitionSize() const { return wii ? dataSize : size; }
+    bool read(uint64_t offset, uint8_t* out, size_t length) {
+        if (!wii) return exact(offset, out, length);
+        if (offset > dataSize || length > dataSize - offset) return false;
+        while (length) {
+            const uint64_t cluster = offset / WiiClusterData, within = offset % WiiClusterData;
+            const size_t n = size_t(std::min<uint64_t>(length, WiiClusterData - within));
+            if (!exact(dataStart + cluster * WiiCluster + WiiClusterHash + within, out, n)) return false;
+            offset += n; out += n; length -= n;
+        }
+        return true;
+    }
+    const char* name(const Entry& e) const { return reinterpret_cast<const char*>(fst.data() + e.name); }
+    // The data partition of a Wii disc (partition type 0 in the first table), checked to be
+    // decrypted: its boot header must name the disc's game.
+    bool findWiiData() {
+        std::array<uint8_t, 8> group{};
+        if (!exact(WiiPartitionInfo, group.data(), group.size())) return false;
+        const uint32_t count = be32(group.data());
+        const uint64_t table = uint64_t(be32(group.data() + 4)) << 2;
+        if (count == 0 || count > 64) return false;
+        for (uint32_t i = 0; i < count; ++i) {
+            std::array<uint8_t, 8> entry{};
+            if (!exact(table + i * 8, entry.data(), entry.size())) return false;
+            if (be32(entry.data() + 4) != 0) continue;
+            const uint64_t partition = uint64_t(be32(entry.data())) << 2;
+            std::array<uint8_t, 8> data{};
+            if (!exact(partition + 0x2b8, data.data(), data.size())) return false;
+            dataStart = partition + (uint64_t(be32(data.data())) << 2);
+            const uint64_t encrypted = uint64_t(be32(data.data() + 4)) << 2;
+            if (dataStart > size) return false;
+            // Whole clusters the image holds.
+            dataSize = std::min(encrypted, size - dataStart) / WiiCluster * WiiClusterData;
+            NodDiscHeader inner{};
+            if (!read(0, reinterpret_cast<uint8_t*>(&inner), sizeof(inner)) ||
+                std::memcmp(inner.game_id, header.game_id, sizeof(header.game_id)) != 0 ||
+                be32(inner.wii_magic) != WiiMagic) {
+                reason = "Encrypted Wii image: decrypt it first with `nodtool convert --decrypt`";
+                return false;
+            }
+            return true;
+        }
+        return false;
+    }
+    // Opening a disc reads its header only: the game inspects the image several times before it
+    // uses it (each a fresh open), and the FST and DOL are megabytes. They are read when the data
+    // partition is first opened (loadContents).
+    bool loadHeader() {
+        if (!exact(0, reinterpret_cast<uint8_t*>(&header), sizeof(header))) return false;
+        if (std::memcmp(header.game_id, "WBFS", 4) == 0) {
+            reason = "WBFS image: convert it to a decrypted ISO with `nodtool convert --decrypt`";
+            return false;
+        }
+        if (be32(header.wii_magic) == WiiMagic) {
+            wii = true;
+            if (!findWiiData()) return false;
+        } else if (be32(header.gcn_magic) != GcnMagic) {
+            return false;
+        }
+        return true;
+    }
+    std::once_flag contentsOnce;
+    bool contentsOk = false;
+    bool ensureContents() {
+        std::call_once(contentsOnce, [this] { contentsOk = loadContents(); });
+        return contentsOk;
+    }
+    bool loadContents() {
+        // Wii boot headers and FSTs store offsets and sizes divided by 4.
+        const unsigned shift = wii ? 2 : 0;
+        const uint64_t limit = partitionSize();
+        std::array<uint8_t, 12> boot{};
+        if (!read(0x420, boot.data(), boot.size())) return false;
+        const uint64_t dolOffset = uint64_t(be32(boot.data())) << shift;
+        const uint64_t fstOffset = uint64_t(be32(boot.data() + 4)) << shift;
+        const uint64_t fstSize = uint64_t(be32(boot.data() + 8)) << shift;
+        if (fstSize < 12 || fstSize > 64 * 1024 * 1024 || fstOffset > limit || fstSize > limit - fstOffset) return false;
+        fst.resize(fstSize);
+        if (!read(fstOffset, fst.data(), fst.size())) return false;
+        const uint32_t count = be32(fst.data() + 8);
+        if (count == 0 || count > fstSize / 12 || fst[0] != 1) return false;
+        const uint32_t names = count * 12;
+        std::vector<uint32_t> directoryEnds{count};
+        for (uint32_t i = 0; i < count; ++i) {
+            const uint8_t* p = fst.data() + i * 12;
+            if (p[0] > 1) return false;
+            const uint32_t stringOffset = be32(p) & 0xffffff;
+            if (stringOffset >= fstSize - names) return false;
+            // A directory's offset and size are entry indices, not shifted.
+            const bool directory = p[0] == 1;
+            Entry e{names + stringOffset, uint64_t(be32(p + 4)) << (directory ? 0 : shift), be32(p + 8), directory};
+            if (!memchr(fst.data() + e.name, 0, fstSize - e.name)) return false;
+            if (i == 0) { if (e.offset != 0 || e.size != count) return false; }
+            else {
+                while (i >= directoryEnds.back()) directoryEnds.pop_back();
+                if (e.directory) {
+                    if (e.offset >= i || e.size <= i || e.size > directoryEnds.back()) return false;
+                    directoryEnds.push_back(e.size);
+                } else if (e.offset > limit || e.size > limit - e.offset) return false;
+            }
+            entries.push_back(e);
+        }
+        // DOL section ranges are offsets relative to the DOL, not load addresses.
+        std::array<uint8_t, 0x100> dolHeader{};
+        if (!read(dolOffset, dolHeader.data(), dolHeader.size())) return false;
+        uint64_t dolSize = dolHeader.size();
+        for (size_t i = 0; i < 18; ++i) {
+            const uint32_t offset = be32(dolHeader.data() + i * 4);
+            const uint32_t length = be32(dolHeader.data() + 0x90 + i * 4);
+            if (length) {
+                if (offset < dolHeader.size()) return false;
+                dolSize = std::max(dolSize, uint64_t(offset) + length);
+            }
+        }
+        if (dolSize > 64 * 1024 * 1024 || dolOffset > limit || dolSize > limit - dolOffset) return false;
+        dol.resize(dolSize);
+        return read(dolOffset, dol.data(), dol.size());
+    }
+};
+}
+struct NodHandle {
+    enum class Kind { Disc, Partition, File } kind;
+    std::shared_ptr<Disc> disc;
+    uint64_t offset{}, size{}, position{};
+};
+
+extern "C" {
+const char* nod_error_message() { return error.empty() ? nullptr : error.c_str(); }
+NodResult nod_disc_open_stream(const NodDiscStream* stream, const NodDiscOptions*, NodHandle** out) {
+    error.clear();
+    if (out) *out = nullptr;
+    if (!stream || !out || !stream->read_at || !stream->stream_len || !stream->close)
+        return fail(NOD_RESULT_ERR_INVALID_HANDLE, "Invalid stream callbacks");
+    // nod owns a valid stream even when format detection fails.
+    bool adopted = false;
+    try {
+        auto disc = std::make_shared<Disc>();
+        disc->stream = *stream; disc->ownsStream = true; adopted = true;
+        const int64_t length = stream->stream_len(stream->user_data);
+        if (length < 0) return fail(NOD_RESULT_ERR_IO, "Cannot determine disc length");
+        disc->size = uint64_t(length);
+        if (!disc->loadHeader()) return fail(NOD_RESULT_ERR_FORMAT, disc->reason);
+        *out = new NodHandle{NodHandle::Kind::Disc, disc, 0, disc->size};
+        return NOD_RESULT_OK;
+    } catch (...) {
+        if (!adopted) stream->close(stream->user_data);
+        return fail(NOD_RESULT_ERR_OTHER, "Cannot allocate disc metadata");
+    }
+}
+void nod_free(NodHandle* handle) { delete handle; }
+NodResult nod_disc_open_partition_kind(NodHandle* disc, uint32_t kind, const NodPartitionOptions*, NodHandle** out) {
+    error.clear(); if (out) *out = nullptr;
+    if (!disc || !out || disc->kind != NodHandle::Kind::Disc) return fail(NOD_RESULT_ERR_INVALID_HANDLE, "Invalid disc");
+    if (kind != NOD_PARTITION_KIND_DATA) return fail(NOD_RESULT_ERR_NOT_FOUND, "Only the data partition is available");
+    if (!disc->disc->ensureContents()) return fail(NOD_RESULT_ERR_FORMAT, disc->disc->reason);
+    *out = new (std::nothrow) NodHandle{NodHandle::Kind::Partition, disc->disc, 0, disc->disc->partitionSize()};
+    return *out ? NOD_RESULT_OK : fail(NOD_RESULT_ERR_OTHER, "Allocation failed");
+}
+NodResult nod_disc_open_partition(NodHandle* disc, uint32_t index, const NodPartitionOptions* options, NodHandle** out) {
+    if (index != 0) { if (out) *out = nullptr; return fail(NOD_RESULT_ERR_NOT_FOUND, "Invalid partition index"); }
+    return nod_disc_open_partition_kind(disc, NOD_PARTITION_KIND_DATA, options, out);
+}
+NodResult nod_partition_open_file(NodHandle* part, uint32_t index, NodHandle** out) {
+    error.clear(); if (out) *out = nullptr;
+    if (!part || !out || part->kind != NodHandle::Kind::Partition) return fail(NOD_RESULT_ERR_INVALID_HANDLE, "Invalid partition");
+    if (index >= part->disc->entries.size() || part->disc->entries[index].directory) return fail(NOD_RESULT_ERR_NOT_FOUND, "Not a file");
+    const auto& e = part->disc->entries[index];
+    *out = new (std::nothrow) NodHandle{NodHandle::Kind::File, part->disc, e.offset, e.size};
+    return *out ? NOD_RESULT_OK : fail(NOD_RESULT_ERR_OTHER, "Allocation failed");
+}
+int64_t nod_read(NodHandle* h, uint8_t* buffer, size_t length) {
+    error.clear();
+    if (!h || (!buffer && length)) { fail(NOD_RESULT_ERR_INVALID_HANDLE, "Invalid read"); return -1; }
+    const size_t count = std::min<uint64_t>(length, h->size - h->position);
+    // The disc handle reads the image; partitions and files read the partition's data.
+    const bool ok = h->kind == NodHandle::Kind::Disc ? h->disc->exact(h->offset + h->position, buffer, count)
+                                                     : h->disc->read(h->offset + h->position, buffer, count);
+    if (!ok) { fail(NOD_RESULT_ERR_IO, "Disc read failed"); return -1; }
+    h->position += count; return count;
+}
+int64_t nod_seek(NodHandle* h, int64_t offset, int32_t whence) {
+    error.clear();
+    if (!h || whence < 0 || whence > 2) return -1;
+    const uint64_t base = whence == 0 ? 0 : (whence == 1 ? h->position : h->size);
+    uint64_t position;
+    if (offset < 0) {
+        const uint64_t negative = uint64_t(-(offset + 1)) + 1;
+        if (negative > base) return -1;
+        position = base - negative;
+    } else {
+        if (uint64_t(offset) > h->size - base) return -1;
+        position = base + uint64_t(offset);
+    }
+    if (position > h->size || position > uint64_t(INT64_MAX)) return -1;
+    h->position = position; return position;
+}
+NodResult nod_disc_header(const NodHandle* h, NodDiscHeader* out) {
+    error.clear();
+    if (!h || !out || h->kind != NodHandle::Kind::Disc) return fail(NOD_RESULT_ERR_INVALID_HANDLE, "Invalid disc header request");
+    *out = h->disc->header; return NOD_RESULT_OK;
+}
+uint64_t nod_disc_size(const NodHandle* h) { return h && h->kind == NodHandle::Kind::Disc ? h->size : 0; }
+NodResult nod_partition_meta(const NodHandle* h, NodPartitionMeta* out) {
+    error.clear();
+    if (!h || !out || h->kind != NodHandle::Kind::Partition) return fail(NOD_RESULT_ERR_INVALID_HANDLE, "Invalid partition metadata request");
+    *out = {}; out->raw_fst = {h->disc->fst.data(), h->disc->fst.size()};
+    out->raw_dol = {h->disc->dol.data(), h->disc->dol.size()}; return NOD_RESULT_OK;
+}
+void nod_partition_iterate_fst(const NodHandle* h, NodFstCallback callback, void* user) {
+    error.clear();
+    if (!h || !callback || h->kind != NodHandle::Kind::Partition) { fail(NOD_RESULT_ERR_INVALID_HANDLE, "Invalid FST iterator"); return; }
+    // Like nod, root is implicit. A directory's size is its next sibling index.
+    for (uint32_t i = 1; i < h->disc->entries.size();) {
+        const auto& e = h->disc->entries[i];
+        const uint32_t next = callback(i, e.directory ? NOD_NODE_KIND_DIRECTORY : NOD_NODE_KIND_FILE,
+            h->disc->name(e), e.size, user);
+        if (next == NOD_FST_STOP) return;
+        if (next <= i) { fail(NOD_RESULT_ERR_OTHER, "FST callback must advance"); return; }
+        i = next;
+    }
+}
+}
+
+// When the drive was last busy reading the image, plus a short window (steady clock, ns): the
+// PS4 build's texture replacement loader waits until then (aurora texture_replacement.cpp).
+extern "C" uint64_t ps4_disc_busy_until_ns(void) { return g_busyUntilNs.load(std::memory_order_relaxed); }
diff --git a/ps4/disc/raw_disc_test.cpp b/ps4/disc/raw_disc_test.cpp
new file mode 100644
index 00000000000..ed462b84e3c
--- /dev/null
+++ b/ps4/disc/raw_disc_test.cpp
@@ -0,0 +1,96 @@
+// SPDX-License-Identifier: MIT
+// Host check of ps4/disc/raw_disc.cpp against a disc nodtool extracted:
+//   raw_disc_test <image.iso> <extracted dir (nodtool extract)>
+// Reads the DOL and every file through the nod API and compares them with sys/main.dol and files/.
+#include <nod.h>
+
+#include <fcntl.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+#include <cstdio>
+#include <cstring>
+#include <fstream>
+#include <iterator>
+#include <string>
+#include <vector>
+
+namespace {
+int64_t read_at(void* user, uint64_t offset, void* out, size_t length) {
+    return pread(*static_cast<int*>(user), out, length, static_cast<off_t>(offset));
+}
+int64_t stream_len(void* user) {
+    struct stat st;
+    return fstat(*static_cast<int*>(user), &st) == 0 ? st.st_size : -1;
+}
+void close_stream(void* user) { close(*static_cast<int*>(user)); }
+
+std::vector<uint8_t> slurp(const std::string& path) {
+    std::ifstream in(path, std::ios::binary);
+    return {std::istreambuf_iterator<char>(in), {}};
+}
+
+struct Walk {
+    NodHandle* partition;
+    std::string root;
+    std::vector<std::pair<uint32_t, std::string>> dirs;  // end index, path
+    unsigned files = 0, mismatches = 0;
+    uint64_t bytes = 0;
+};
+
+uint32_t visit(uint32_t index, NodNodeKind kind, const char* name, uint32_t size, void* user) {
+    auto& w = *static_cast<Walk*>(user);
+    while (!w.dirs.empty() && index >= w.dirs.back().first) w.dirs.pop_back();
+    const std::string parent = w.dirs.empty() ? "" : w.dirs.back().second;
+    const std::string path = parent + "/" + name;
+    if (kind == NOD_NODE_KIND_DIRECTORY) {
+        w.dirs.emplace_back(size, path);
+        return index + 1;
+    }
+    NodHandle* file = nullptr;
+    std::vector<uint8_t> data(size);
+    bool ok = nod_partition_open_file(w.partition, index, &file) == NOD_RESULT_OK &&
+              nod_read(file, data.data(), size) == int64_t(size);
+    nod_free(file);
+    ok = ok && data == slurp(w.root + "/files" + path);
+    if (!ok && w.mismatches++ < 10) std::printf("MISMATCH %s\n", path.c_str());
+    w.files++;
+    w.bytes += size;
+    return index + 1;
+}
+}  // namespace
+
+int main(int argc, char** argv) {
+    if (argc != 3) {
+        std::fprintf(stderr, "usage: %s <image> <extracted dir>\n", argv[0]);
+        return 2;
+    }
+    static int fd = open(argv[1], O_RDONLY);
+    NodDiscStream stream{&fd, read_at, stream_len, close_stream};
+    NodHandle* disc = nullptr;
+    if (nod_disc_open_stream(&stream, nullptr, &disc) != NOD_RESULT_OK) {
+        std::printf("open failed: %s\n", nod_error_message());
+        return 1;
+    }
+    NodDiscHeader header{};
+    nod_disc_header(disc, &header);
+    std::printf("disc %.6s, %.64s\n", header.game_id, header.game_title);
+    NodHandle* partition = nullptr;
+    if (nod_disc_open_partition_kind(disc, NOD_PARTITION_KIND_DATA, nullptr, &partition) != NOD_RESULT_OK) {
+        std::printf("no data partition: %s\n", nod_error_message());
+        return 1;
+    }
+    NodPartitionMeta meta{};
+    nod_partition_meta(partition, &meta);
+    const auto dol = slurp(std::string(argv[2]) + "/sys/main.dol");
+    const bool dolOk = meta.raw_dol.size <= dol.size() &&
+                       std::memcmp(meta.raw_dol.data, dol.data(), meta.raw_dol.size) == 0;
+    std::printf("DOL %zu bytes: %s\n", static_cast<size_t>(meta.raw_dol.size), dolOk ? "matches" : "DIFFERS");
+
+    Walk walk{partition, argv[2], {}};
+    nod_partition_iterate_fst(partition, visit, &walk);
+    std::printf("%u files, %.1f MiB, %u mismatches\n", walk.files, walk.bytes / 1048576.0, walk.mismatches);
+    nod_free(partition);
+    nod_free(disc);
+    return dolOk && walk.mismatches == 0 && walk.files > 0 ? 0 : 1;
+}
diff --git a/ps4/funchook_ps4.c b/ps4/funchook_ps4.c
new file mode 100644
index 00000000000..df5448cb9c3
--- /dev/null
+++ b/ps4/funchook_ps4.c
@@ -0,0 +1,158 @@
+/*
+ * funchook's platform layer for the PS4 build, in place of funchook_unix.c (ps4/Platform.cmake).
+ *
+ * The console has no /proc/self/maps to find free memory near a function, and the game is one
+ * statically linked image, so trampolines come from a pool reserved inside the image's own code
+ * (always within the 2 GiB a 32-bit jump reaches). The pool and patched functions are made
+ * writable with sceKernelMprotect, keeping execute permission: other threads may be running code
+ * in the same pages while a hook is written.
+ */
+#include "config.h"
+#include <errno.h>
+#include <pthread.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include "funchook_internal.h"
+
+int32_t sceKernelMprotect(const void *addr, size_t len, int prot);
+
+#define PS4_PROT_RX 0x5  /* PROT_READ | PROT_EXEC */
+#define PS4_PROT_RWX 0x7 /* PROT_READ | PROT_WRITE | PROT_EXEC */
+/* The console's protection granularity. */
+#define PS4_PROTECT_UNIT 0x4000
+/* Dusklight creates a funchook instance, and so takes a page, per hook. */
+#define PS4_POOL_BYTES 0x200000
+#define PS4_POOL_PAGES (PS4_POOL_BYTES / PAGE_SIZE)
+
+const size_t page_size = PAGE_SIZE;
+
+/* The trampoline pool: int3-filled, in .text so it lies close to every game function. */
+__asm__(".pushsection .text.ps4_funchook_pool,\"ax\",@progbits\n"
+        ".balign 16384\n"
+        "ps4_funchook_pool:\n"
+        ".fill 2097152, 1, 0xcc\n"
+        ".popsection\n");
+extern uint8_t ps4_funchook_pool[];
+static uint8_t s_page_used[PS4_POOL_PAGES];
+static int s_pool_writable;
+static pthread_mutex_t s_pool_lock = PTHREAD_MUTEX_INITIALIZER;
+
+const char *funchook_strerror(int errnum, char *buf, size_t buflen)
+{
+    snprintf(buf, buflen, "%s", strerror(errnum));
+    return buf;
+}
+
+funchook_t *funchook_alloc(void)
+{
+    return (funchook_t *)calloc(1, funchook_size);
+}
+
+int funchook_free(funchook_t *funchook)
+{
+    free(funchook);
+    return 0;
+}
+
+int funchook_page_alloc(funchook_t *funchook, funchook_page_t **page_out, uint8_t *func, ip_displacement_t *disp)
+{
+    size_t index;
+
+    (void)func;
+    (void)disp;
+    pthread_mutex_lock(&s_pool_lock);
+    if (!s_pool_writable) {
+        int32_t rv = sceKernelMprotect(ps4_funchook_pool, PS4_POOL_BYTES, PS4_PROT_RWX);
+        if (rv != 0) {
+            pthread_mutex_unlock(&s_pool_lock);
+            funchook_set_error_message(funchook, "sceKernelMprotect(trampoline pool, rwx) = 0x%x", (unsigned)rv);
+            return FUNCHOOK_ERROR_MEMORY_FUNCTION;
+        }
+        s_pool_writable = 1;
+    }
+    for (index = 0; index < PS4_POOL_PAGES && s_page_used[index]; index++) {
+    }
+    if (index == PS4_POOL_PAGES) {
+        pthread_mutex_unlock(&s_pool_lock);
+        funchook_set_error_message(funchook, "the PS4 trampoline pool (%u pages) is used up", (unsigned)PS4_POOL_PAGES);
+        return FUNCHOOK_ERROR_MEMORY_ALLOCATION;
+    }
+    s_page_used[index] = 1;
+    pthread_mutex_unlock(&s_pool_lock);
+    *page_out = (funchook_page_t *)(ps4_funchook_pool + index * page_size);
+    memset(*page_out, 0, page_size);
+    funchook_log(funchook, "  allocate page %p (size=%" PRIuPTR ")\n", (void *)*page_out, page_size);
+    return 0;
+}
+
+int funchook_page_free(funchook_t *funchook, funchook_page_t *page)
+{
+    const size_t index = (size_t)((uint8_t *)page - ps4_funchook_pool) / page_size;
+
+    (void)funchook;
+    memset(page, 0xcc, page_size);
+    pthread_mutex_lock(&s_pool_lock);
+    if (index < PS4_POOL_PAGES) {
+        s_page_used[index] = 0;
+    }
+    pthread_mutex_unlock(&s_pool_lock);
+    return 0;
+}
+
+/* The pool stays readable, writable and executable. */
+int funchook_page_protect(funchook_t *funchook, funchook_page_t *page)
+{
+    (void)funchook;
+    (void)page;
+    return 0;
+}
+
+int funchook_page_unprotect(funchook_t *funchook, funchook_page_t *page)
+{
+    (void)funchook;
+    (void)page;
+    return 0;
+}
+
+int funchook_unprotect_begin(funchook_t *funchook, mem_state_t *mstate, void *start, size_t len)
+{
+    size_t saddr = ROUND_DOWN((size_t)start, PS4_PROTECT_UNIT);
+    int32_t rv;
+
+    mstate->addr = (void *)saddr;
+    mstate->size = ROUND_UP(len + (size_t)start - saddr, PS4_PROTECT_UNIT);
+    rv = sceKernelMprotect(mstate->addr, mstate->size, PS4_PROT_RWX);
+    if (rv != 0) {
+        funchook_set_error_message(funchook, "sceKernelMprotect(%p, 0x%zx, rwx) = 0x%x", mstate->addr,
+                                   mstate->size, (unsigned)rv);
+        return FUNCHOOK_ERROR_MEMORY_FUNCTION;
+    }
+    funchook_log(funchook, "  unprotect memory %p (size=%" PRIuPTR ") <- %p (size=%" PRIuPTR ")\n",
+                 mstate->addr, mstate->size, start, len);
+    return 0;
+}
+
+int funchook_unprotect_end(funchook_t *funchook, const mem_state_t *mstate)
+{
+    /* Pages of the pool stay writable (funchook_page_protect). */
+    uint8_t *addr = (uint8_t *)mstate->addr;
+    if (addr + mstate->size > ps4_funchook_pool && addr < ps4_funchook_pool + PS4_POOL_BYTES) {
+        return 0;
+    }
+    int32_t rv = sceKernelMprotect(mstate->addr, mstate->size, PS4_PROT_RX);
+    if (rv != 0) {
+        funchook_set_error_message(funchook, "sceKernelMprotect(%p, 0x%zx, rx) = 0x%x", mstate->addr,
+                                   mstate->size, (unsigned)rv);
+        return FUNCHOOK_ERROR_MEMORY_FUNCTION;
+    }
+    return 0;
+}
+
+/* One statically linked image: a function's address is its code. */
+void *funchook_resolve_func(funchook_t *funchook, void *func)
+{
+    (void)funchook;
+    return func;
+}
diff --git a/ps4/input.cpp b/ps4/input.cpp
new file mode 100644
index 00000000000..1e9bd1c1088
--- /dev/null
+++ b/ps4/input.cpp
@@ -0,0 +1,64 @@
+// PS4 controllers as SDL virtual gamepads: the PS5 port's ps5/input.cpp, over ps4/native/platform.c.
+// aurora calls the ps5_input_* hooks on both consoles (extern/aurora/lib/input.cpp, aurora.cpp).
+#include <SDL3/SDL.h>
+#include "native/platform.h"
+#include <algorithm>
+
+namespace {
+struct Player { int slot; SDL_JoystickID id = 0; SDL_Joystick* joystick = nullptr; };
+Player players[PAD_PLAYERS]{{0},{1},{2},{3}};
+bool rumble(void* data, Uint16 low, Uint16 high) {
+    pad_player_vibrate(static_cast<Player*>(data)->slot, low / 65535.f, high / 65535.f);
+    return true;
+}
+bool led(void* data, Uint8 r, Uint8 g, Uint8 b) {
+    pad_player_light_bar(static_cast<Player*>(data)->slot, r, g, b);
+    return true;
+}
+// SDL's buttons in their physical places (Cross south, Circle east), for a DualShock 4: Dusklight
+// names them Cross, Circle, Square and Triangle. Which is A and which is B is aurora's PS4 mapping
+// (Circle confirms as A, Cross goes back as B, as on Nintendo's pads), so the game and its menus
+// agree; the PlayStation button textures match (tools/make-ps-buttons.py).
+constexpr unsigned buttons[] = {PAD_CROSS, PAD_CIRCLE, PAD_SQUARE, PAD_TRIANGLE,
+    PAD_TOUCH_PAD, 0, PAD_OPTIONS, PAD_L3, PAD_R3, PAD_L1, PAD_R1,
+    PAD_UP, PAD_DOWN, PAD_LEFT, PAD_RIGHT};
+Sint16 axis(float value) {
+    return static_cast<Sint16>(std::clamp(value * 32767.f, -32768.f, 32767.f));
+}
+void detach(Player& p) {
+    pad_player_vibrate(p.slot, 0, 0);
+    if (p.joystick) SDL_CloseJoystick(p.joystick);
+    if (p.id) SDL_DetachVirtualJoystick(p.id);
+    p.id = 0; p.joystick = nullptr;
+}
+}
+extern "C" void ps5_input_initialize() { pad_open(); }
+extern "C" void ps5_input_shutdown() { for (auto& p : players) detach(p); }
+extern "C" void ps5_input_poll() {
+    pad first{}; pad_poll(&first);
+    for (auto& p : players) {
+        pad state{};
+        if (!pad_player(p.slot, &state)) { if (p.id) detach(p); continue; }
+        if (!p.id) {
+            SDL_VirtualJoystickDesc desc{}; SDL_INIT_INTERFACE(&desc);
+            desc.type = SDL_JOYSTICK_TYPE_GAMEPAD;
+            desc.naxes = SDL_GAMEPAD_AXIS_COUNT; desc.nbuttons = 15;
+            desc.axis_mask = (1u << desc.naxes) - 1;
+            desc.button_mask = (1u << desc.nbuttons) - 1;
+            desc.name = "DUALSHOCK 4"; desc.userdata = &p;
+            desc.vendor_id = 0x054c; desc.product_id = 0x09cc;  // Sony DualShock 4 (CUH-ZCT2)
+            desc.Rumble = rumble; desc.SetLED = led;
+            p.id = SDL_AttachVirtualJoystick(&desc);
+            if (!p.id) { say("Controller attach failed: %s", SDL_GetError()); continue; }
+            p.joystick = SDL_OpenJoystick(p.id);
+            if (!p.joystick) { detach(p); continue; }
+            SDL_SetJoystickPlayerIndex(p.joystick, p.slot);
+        }
+        const float axes[] = {state.left_x, state.left_y, state.right_x,
+            state.right_y, state.l2 * 2 - 1, state.r2 * 2 - 1};
+        for (int i = 0; i < SDL_GAMEPAD_AXIS_COUNT; ++i)
+            SDL_SetJoystickVirtualAxis(p.joystick, i, axis(axes[i]));
+        for (int i = 0; i < 15; ++i)
+            SDL_SetJoystickVirtualButton(p.joystick, i, (state.held & buttons[i]) != 0);
+    }
+}
diff --git a/ps4/main.cpp b/ps4/main.cpp
new file mode 100644
index 00000000000..0f5a6b78e5b
--- /dev/null
+++ b/ps4/main.cpp
@@ -0,0 +1,52 @@
+// The PS4 title's entry point, after ps5/main.cpp. /app0 (the installed package) is read-only on
+// the PS4, so the user data, logs and the game's disc image live in /data/dusklight-ps4: copy your
+// own GameCube disc image there as game.iso.
+#include <sys/stat.h>
+
+#include <cstdio>
+#include <filesystem>
+#include <system_error>
+
+#include <SDL3/SDL_stdinc.h>
+
+#include "native/platform.h"
+#include "prof/ps4_profiler.hpp"
+
+extern "C" int aurora_main(int argc, char** argv);
+
+int main() {
+    platform_init("Dusklight");
+#if PS4_DEV_TOOLS
+    // The profiler reports frame statistics to the log (ps4/prof); /data/dusklight-ps4/prof adds its
+    // zones and the sampler, /data/dusklight-ps4/noprof turns it off. The release has no profiler.
+    struct stat noProfiler {};
+    if (stat("/data/dusklight-ps4/noprof", &noProfiler) != 0)
+        ps4prof::start();
+#endif
+    mkdir("/data/dusklight-ps4/user", 0777);
+    mkdir("/data/dusklight-ps4/logs", 0777);
+    mkdir("/data/dusklight-ps4/cache", 0777);
+    // The console preset (ps4/default-config.json: English, no update checks), on the first run only.
+    std::error_code error;
+    if (!std::filesystem::exists("/data/dusklight-ps4/user/config.json", error))
+        std::filesystem::copy_file("/app0/default-config.json", "/data/dusklight-ps4/user/config.json", error);
+
+    SDL_Environment* environment = SDL_GetEnvironment();
+    SDL_SetEnvironmentVariable(environment, "SDL_VIDEODRIVER", "dummy", true);
+    // SDL3's SceAudioOut driver (src/audio/ps5 in the SDL3 fork) serves both consoles.
+    SDL_SetEnvironmentVariable(environment, "SDL_AUDIODRIVER", "ps5", true);
+    SDL_SetEnvironmentVariable(environment, "XDG_DATA_HOME", "/data/dusklight-ps4/user", true);
+
+    char app[] = "/app0/eboot.bin";
+    char user[] = "--user-dir=/data/dusklight-ps4/user";
+    char log[] = "--log-dir=/data/dusklight-ps4/logs";
+    // The game image: inside the package when the Setup Studio built a complete one (/app0/game.iso),
+    // otherwise the one copied to /data (the separate setup).
+    struct stat embedded {};
+    char disc[64];
+    std::snprintf(disc, sizeof(disc), "%s",
+        stat("/app0/game.iso", &embedded) == 0 ? "/app0/game.iso" : "/data/dusklight-ps4/game.iso");
+    char* args[] = {app, user, log, disc, nullptr};
+    const int status = aurora_main(4, args);
+    catchReturnFromMain(status);
+}
diff --git a/ps4/native/platform.c b/ps4/native/platform.c
new file mode 100644
index 00000000000..4c68742c791
--- /dev/null
+++ b/ps4/native/platform.c
@@ -0,0 +1,359 @@
+/*
+ * The PS4 console layer for Dusklight: log, splash, pads, time, exit.
+ *
+ * After the PS5 port's ps5/native/platform.c (PS5 Vulkan Template, Copyright (C) 2026 Mihawk,
+ * MIT): the same players and pad readings, with the PS4's pad calls and data, and the system
+ * modules loaded first, as DolphinPS4 loads them.
+ *
+ * This code is licensed under the MIT license (MIT) (http://opensource.org/licenses/MIT)
+ */
+#include "platform.h"
+
+#include <fcntl.h>
+#include <stdarg.h>
+#include <stddef.h>
+#include <stdio.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <time.h>
+#include <unistd.h>
+
+/* Declared here rather than through the OpenOrbis headers, as DolphinPS4's Mesa layer does. */
+int sceSysmoduleLoadModuleInternal(uint32_t id);
+int sceSystemServiceHideSplashScreen(void);
+int sceSystemServiceLoadExec(const char *path, char *const argv[]);
+int sceUserServiceInitialize(const void *params);
+int sceUserServiceGetInitialUser(int32_t *user_id);
+/* The signed-in users, at most four; unused entries are -1. */
+struct user_list {
+   int32_t user_id[4];
+};
+int sceUserServiceGetLoginUserIdList(struct user_list *list);
+int scePadInit(void);
+int scePadOpen(int32_t user_id, int32_t port_type, int32_t index, const void *params);
+int scePadGetHandle(int32_t user_id, uint32_t port_type, uint32_t index);
+int scePadReadState(int32_t handle, void *data);
+int scePadClose(int32_t handle);
+int scePadSetVibration(int32_t handle, const void *vibration);
+int scePadSetLightBar(int32_t handle, const void *color);
+int sceKernelUsleep(unsigned int microseconds);
+int sceKernelDebugOutText(int channel, const char *text);
+
+#define LOG_DIR "/data/dusklight-ps4"
+
+/* Calling into a system library whose module isn't loaded kills the title
+ * (PRX_NOT_RESOLVED_FUNCTION); DolphinPS4 loads these first. */
+static const struct {
+   const char *name;
+   uint32_t id;
+} system_modules[] = {
+   {"SystemService", 0x80000010},
+   {"UserService", 0x80000011},
+   {"VideoOut", 0x80000022},
+   {"AudioOut", 0x80000001},
+   {"Pad", 0x80000024},
+   /* The C library's resolver (getaddrinfo) imports sceNetGetDnsInfo. */
+   {"Net", 0x8000001c},
+};
+
+void
+platform_init(const char *title_name)
+{
+   mkdir(LOG_DIR, 0777);
+   /* The previous run's log stays as dusklight.prev.log (a restart would otherwise overwrite the
+    * one that showed a problem). freopen(stderr) leaves the file empty on the console; point
+    * descriptor 2 at it instead. */
+   rename(LOG_DIR "/dusklight.log", LOG_DIR "/dusklight.prev.log");
+   const int log = open(LOG_DIR "/dusklight.log", O_WRONLY | O_CREAT | O_TRUNC, 0666);
+   if (log >= 0) {
+      dup2(log, 2);
+      if (log != 2)
+         close(log);
+   }
+   setvbuf(stderr, NULL, _IONBF, 0);
+   say("%s starts", title_name);
+   for (size_t i = 0; i < sizeof(system_modules) / sizeof(system_modules[0]); i++) {
+      const int result = sceSysmoduleLoadModuleInternal(system_modules[i].id);
+      if (result != 0)
+         say("loading system module %s failed (%#x)", system_modules[i].name, (unsigned)result);
+   }
+   /* The shell's splash (sce_sys/pic1.png) covers the title until ps4_hide_splash: it stays up
+    * through loading, which showed black for the first seconds, until the first frame. */
+}
+
+void
+ps4_hide_splash(void)
+{
+   static volatile int hidden;
+   if (__atomic_exchange_n(&hidden, 1, __ATOMIC_ACQ_REL))
+      return;
+   say("splash dismissed: %d", sceSystemServiceHideSplashScreen());
+}
+
+void
+say(const char *format, ...)
+{
+   char line[1024];
+   va_list args;
+   va_start(args, format);
+   int n = vsnprintf(line, sizeof(line) - 1, format, args);
+   va_end(args);
+   if (n < 0)
+      return;
+   if (n > (int)sizeof(line) - 2)
+      n = sizeof(line) - 2;
+   line[n] = '\n';
+   line[n + 1] = '\0';
+   fputs(line, stderr);
+   fflush(stderr);
+   sceKernelDebugOutText(0, line);
+}
+
+double
+now_seconds(void)
+{
+   struct timespec t;
+   clock_gettime(CLOCK_MONOTONIC, &t);
+   return (double)t.tv_sec + (double)t.tv_nsec / 1e9;
+}
+
+void
+catchReturnFromMain(int status)
+{
+   say("exit status %d: asking the shell to close the title", status);
+   fflush(NULL);
+   (void)sceSystemServiceLoadExec("exit", NULL);
+   for (;;)
+      sceKernelUsleep(100000);
+}
+
+/* ----------------------------------------------------------------- the pad */
+
+/* One reading as the PS4 writes it (OpenOrbis's OrbisPadData): 120 bytes, the
+ * same size and the same places for buttons, sticks, connection and time as
+ * the PS5's samples. */
+struct pad_sample {
+   uint32_t buttons;
+   uint8_t left_x, left_y, right_x, right_y, l2, r2;
+   uint16_t padding;
+   float orientation[4];
+   float velocity[3];
+   float acceleration[3];
+   uint8_t touch[24];
+   uint8_t connected;
+   uint64_t timestamp_us;
+   uint8_t extension[16];
+   uint8_t connected_count;
+   uint8_t reserved[15];
+};
+_Static_assert(sizeof(struct pad_sample) == 120, "the console's pad readings are 120 bytes");
+_Static_assert(offsetof(struct pad_sample, connected) == 0x4c, "connection state sits at 0x4c");
+_Static_assert(offsetof(struct pad_sample, timestamp_us) == 0x50, "the timestamp sits at 0x50");
+
+/* Set in a reading's buttons while the shell has the pad (the home screen, a
+ * system dialog): that reading is not input for the title. */
+#define PAD_INTERCEPTED 0x80000000u
+
+struct pad_player_state {
+   int32_t user;
+   int32_t handle;
+   struct pad_sample last;
+};
+
+static struct pad_player_state pad_states[PAD_PLAYERS];
+static bool pad_service;
+static double pad_next_scan;
+/* A user whose controller would not open, said once rather than every scan. */
+static int32_t pad_unopened = -1;
+#define PAD_SCAN_SECONDS 1.0
+
+static struct pad_player_state *
+pad_state(int player)
+{
+   if (!pad_service || player < 0 || player >= PAD_PLAYERS || pad_states[player].handle < 0)
+      return NULL;
+   return &pad_states[player];
+}
+
+static void
+pad_rest(struct pad_player_state *state)
+{
+   memset(state, 0, sizeof(*state));
+   state->user = state->handle = -1;
+   state->last.left_x = state->last.left_y = state->last.right_x = state->last.right_y = 128;
+}
+
+static bool
+pad_player_open(int player, int32_t user, int attempts)
+{
+   struct pad_player_state *state = &pad_states[player];
+   pad_rest(state);
+   /* A title can start before the pad service has published the device. */
+   int32_t handle = -1;
+   for (int attempt = 0; attempt < attempts && handle < 0; attempt++) {
+      handle = scePadOpen(user, 0, 0, NULL);
+      if (handle < 0 && attempt + 1 < attempts)
+         sceKernelUsleep(100000);
+   }
+   /* A handle this process already holds for the user is reused. */
+   if (handle < 0)
+      handle = scePadGetHandle(user, 0, 0);
+   if (handle < 0) {
+      if (user != pad_unopened)
+         say("pad: scePadOpen failed for user %d (player %d): %#x", (int)user, player, (unsigned)handle);
+      pad_unopened = user;
+      return false;
+   }
+   state->user = user;
+   state->handle = handle;
+   say("pad: player %d opened for user %d", player, (int)user);
+   return true;
+}
+
+static void
+pad_player_close(int player, const char *why)
+{
+   struct pad_player_state *state = &pad_states[player];
+   if (state->handle < 0)
+      return;
+   say("pad: player %d let go (user %d %s), close %d", player, (int)state->user, why, scePadClose(state->handle));
+   pad_rest(state);
+}
+
+/* The signed-in users again: player 0 stays; a player whose user signed out is
+ * let go; a new user's controller takes the first free player. */
+static void
+pad_scan(void)
+{
+   struct user_list list = {{-1, -1, -1, -1}};
+   if (sceUserServiceGetLoginUserIdList(&list) < 0)
+      return;
+   for (int player = 1; player < PAD_PLAYERS; player++) {
+      if (pad_states[player].handle < 0)
+         continue;
+      bool signed_in = false;
+      for (int i = 0; i < 4; i++)
+         signed_in |= list.user_id[i] >= 0 && list.user_id[i] == pad_states[player].user;
+      if (!signed_in)
+         pad_player_close(player, "signed out");
+   }
+   for (int i = 0; i < 4; i++) {
+      const int32_t user = list.user_id[i];
+      bool known = user < 0;
+      for (int player = 0; player < PAD_PLAYERS && !known; player++)
+         known = pad_states[player].handle >= 0 && pad_states[player].user == user;
+      for (int player = 0; player < PAD_PLAYERS && !known; player++) {
+         if (pad_states[player].handle < 0) {
+            (void)pad_player_open(player, user, 1);
+            break;
+         }
+      }
+   }
+}
+
+bool
+pad_open(void)
+{
+   for (int player = 0; player < PAD_PLAYERS; player++)
+      pad_rest(&pad_states[player]);
+   (void)sceUserServiceInitialize(NULL);
+   int32_t user = -1;
+   if (sceUserServiceGetInitialUser(&user) < 0 || scePadInit() < 0) {
+      say("pad: no user or no pad service");
+      return false;
+   }
+   pad_service = true;
+   const bool opened = pad_player_open(0, user, 10);
+   pad_scan();
+   pad_next_scan = now_seconds() + PAD_SCAN_SECONDS;
+   return opened;
+}
+
+static float
+stick(uint8_t value)
+{
+   const float v = ((float)value - 128.0f) / 127.0f;
+   const float dead = 0.12f;
+   if (v > -dead && v < dead)
+      return 0.0f;
+   return v > 0 ? (v - dead) / (1.0f - dead) : (v + dead) / (1.0f - dead);
+}
+
+static void
+pad_fill(const struct pad_player_state *state, struct pad *pad)
+{
+   const uint32_t before = pad->held;
+   pad->held = state->handle >= 0 ? state->last.buttons : 0;
+   pad->pressed = pad->held & ~before;
+   pad->left_x = stick(state->last.left_x);
+   pad->left_y = stick(state->last.left_y);
+   pad->right_x = stick(state->last.right_x);
+   pad->right_y = stick(state->last.right_y);
+   pad->l2 = state->last.l2 / 255.0f;
+   pad->r2 = state->last.r2 / 255.0f;
+}
+
+void
+pad_poll(struct pad *pad)
+{
+   if (pad_service && now_seconds() >= pad_next_scan) {
+      pad_scan();
+      pad_next_scan = now_seconds() + PAD_SCAN_SECONDS;
+   }
+   for (int player = 0; player < PAD_PLAYERS; player++) {
+      struct pad_player_state *state = pad_state(player);
+      if (state == NULL)
+         continue;
+      struct pad_sample sample;
+      memset(&sample, 0, sizeof(sample));
+      if (scePadReadState(state->handle, &sample) < 0 || !sample.connected)
+         continue;
+      /* While the shell has the pad, the title sees it at rest. */
+      if (sample.buttons & PAD_INTERCEPTED) {
+         const int32_t user = state->user, handle = state->handle;
+         pad_rest(state);
+         state->user = user;
+         state->handle = handle;
+         continue;
+      }
+      state->last = sample;
+   }
+   (void)pad_player(0, pad);
+}
+
+bool
+pad_player(int player, struct pad *pad)
+{
+   const struct pad_player_state *state = pad_state(player);
+   if (state == NULL) {
+      struct pad_player_state rest;
+      pad_rest(&rest);
+      pad_fill(&rest, pad);
+      return false;
+   }
+   pad_fill(state, pad);
+   return true;
+}
+
+void
+pad_player_vibrate(int player, float large, float small)
+{
+   const struct pad_player_state *state = pad_state(player);
+   if (state == NULL)
+      return;
+   const uint8_t motors[2] = {
+      (uint8_t)(large <= 0 ? 0 : large >= 1 ? 255 : large * 255.0f),
+      (uint8_t)(small <= 0 ? 0 : small >= 1 ? 255 : small * 255.0f),
+   };
+   scePadSetVibration(state->handle, motors);
+}
+
+void
+pad_player_light_bar(int player, uint8_t r, uint8_t g, uint8_t b)
+{
+   const struct pad_player_state *state = pad_state(player);
+   if (state == NULL)
+      return;
+   const uint8_t color[4] = {r, g, b, 255};
+   scePadSetLightBar(state->handle, color);
+}
diff --git a/ps4/native/platform.h b/ps4/native/platform.h
new file mode 100644
index 00000000000..391a1bfbf81
--- /dev/null
+++ b/ps4/native/platform.h
@@ -0,0 +1,83 @@
+/*
+ * The PS4 console layer for Dusklight: log, splash, pads, time, exit.
+ *
+ * The interface of the PS5 port's ps5/native/platform.h (PS5 Vulkan Template, Copyright (C) 2026
+ * Mihawk, MIT), less its audio (SDL3's SceAudioOut driver plays the game's sound), so that
+ * ps4/input.cpp is the PS5 port's input.cpp.
+ *
+ * This code is licensed under the MIT license (MIT) (http://opensource.org/licenses/MIT)
+ */
+#pragma once
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* Standard error to /data/dusklight-ps4/dusklight.log and the system modules the game calls
+ * loaded. Call first. */
+void platform_init(const char *title_name);
+
+/* Dismisses the shell's splash (sce_sys/pic1.png), once: aurora calls it when the first frame is
+ * on screen. */
+void ps4_hide_splash(void);
+
+/* One line to the log and the kernel's debug output, flushed. */
+void say(const char *format, ...) __attribute__((format(printf, 1, 2)));
+
+double now_seconds(void);
+
+/* Asks the shell to close the title and never returns: returning from main or exit() makes the
+ * console report a crash. */
+void catchReturnFromMain(int status);
+
+/* The pad, in the console's button numbering (the same on PS4 and PS5). */
+enum {
+   PAD_L3 = 0x000002,
+   PAD_R3 = 0x000004,
+   PAD_OPTIONS = 0x000008,
+   PAD_UP = 0x000010,
+   PAD_RIGHT = 0x000020,
+   PAD_DOWN = 0x000040,
+   PAD_LEFT = 0x000080,
+   PAD_L1 = 0x000400,
+   PAD_R1 = 0x000800,
+   PAD_TRIANGLE = 0x001000,
+   PAD_CIRCLE = 0x002000,
+   PAD_CROSS = 0x004000,
+   PAD_SQUARE = 0x008000,
+   PAD_TOUCH_PAD = 0x100000,
+};
+
+struct pad {
+   uint32_t held;    /* buttons down now */
+   uint32_t pressed; /* buttons that went down since the last poll */
+   float left_x, left_y, right_x, right_y; /* -1..1, a dead zone removed; y is down-positive */
+   float l2, r2;                           /* 0..1 */
+};
+
+/* Up to four players, one per signed-in user: the console pairs each controller with a user.
+ * Player 0 is the user who started the title; pad_poll reads the signed-in users again about
+ * once a second, a new user's controller takes the first free player, and a player is let go
+ * when their user signs out. */
+#define PAD_PLAYERS 4
+
+/* Open player 0's pad (the first user's), and every other signed-in user's; false when there is
+ * none. */
+bool pad_open(void);
+/* Read every player's controller; *pad is player 0's. Call once a frame. */
+void pad_poll(struct pad *pad);
+/* A player's pad as the last pad_poll read it; false, and a pad at rest, when that player has
+ * none. */
+bool pad_player(int player, struct pad *pad);
+
+/* Rumble: the large and the small motor, 0..1 each; 0, 0 stops it. */
+void pad_player_vibrate(int player, float large, float small);
+/* The light bar's colour. */
+void pad_player_light_bar(int player, uint8_t r, uint8_t g, uint8_t b);
+
+#ifdef __cplusplus
+}
+#endif
diff --git a/ps4/native/realpath.c b/ps4/native/realpath.c
new file mode 100644
index 00000000000..b876236cd84
--- /dev/null
+++ b/ps4/native/realpath.c
@@ -0,0 +1,86 @@
+/*
+ * realpath() for the PS4 build (linked with --wrap=realpath, ps4/Platform.cmake).
+ *
+ * OpenOrbis' musl resolves paths through /proc/self/fd, which the console does not have, so its
+ * realpath fails with ENOSYS, and with it std::filesystem::canonical, weakly_canonical, relative
+ * and proximate. The game's paths (/app0, /data) hold no symbolic links: the path is made
+ * absolute and its "." and ".." components are folded, and it must exist, as realpath requires.
+ */
+#include <errno.h>
+#include <limits.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+char *__wrap_realpath(const char *restrict path, char *restrict resolved)
+{
+    char out[PATH_MAX];
+    size_t len = 0;
+    const char *p = path;
+    struct stat st;
+
+    if (path == NULL) {
+        errno = EINVAL;
+        return NULL;
+    }
+    if (*path == '\0') {
+        errno = ENOENT;
+        return NULL;
+    }
+    if (*path != '/') {
+        if (getcwd(out, sizeof(out)) == NULL) {
+            out[0] = '\0';  /* no working directory: relative to the root */
+        }
+        len = strlen(out);
+        while (len > 0 && out[len - 1] == '/') {
+            --len;
+        }
+    }
+
+    while (*p != '\0') {
+        const char *end;
+        size_t n;
+
+        while (*p == '/') {
+            ++p;
+        }
+        end = p;
+        while (*end != '\0' && *end != '/') {
+            ++end;
+        }
+        n = (size_t)(end - p);
+        if (n == 0 || (n == 1 && p[0] == '.')) {
+            /* nothing */
+        } else if (n == 2 && p[0] == '.' && p[1] == '.') {
+            while (len > 0 && out[len - 1] != '/') {
+                --len;
+            }
+            if (len > 0) {
+                --len;  /* the separator */
+            }
+        } else {
+            if (len + 1 + n >= sizeof(out)) {
+                errno = ENAMETOOLONG;
+                return NULL;
+            }
+            out[len++] = '/';
+            memcpy(out + len, p, n);
+            len += n;
+        }
+        p = end;
+    }
+    if (len == 0) {
+        out[len++] = '/';
+    }
+    out[len] = '\0';
+
+    if (stat(out, &st) != 0) {
+        return NULL;  /* errno from stat, ENOENT for a missing path */
+    }
+    if (resolved == NULL) {
+        return strdup(out);
+    }
+    memcpy(resolved, out, len + 1);
+    return resolved;
+}
diff --git a/ps4/pgo.cpp b/ps4/pgo.cpp
new file mode 100644
index 00000000000..796bf0b16c1
--- /dev/null
+++ b/ps4/pgo.cpp
@@ -0,0 +1,28 @@
+// SPDX-License-Identifier: MIT
+// The instrumented build of profile-guided optimisation (tools/build-game.sh PGO=generate): the
+// profiler's reporter calls ps4_pgo_dump after 15 s and then every minute, since the console closes a title without
+// running exit handlers. Dumps alternate between two files, so a title closed mid-write still
+// leaves the previous one whole.
+#include <cstdio>
+
+#include <sys/stat.h>
+
+extern "C" {
+int __llvm_profile_write_file(void);
+void __llvm_profile_set_filename(const char* name);
+
+void ps4_pgo_dump(void) {
+    static unsigned s_dumps = 0;
+    if (s_dumps == 0) {
+        mkdir("/data/dusklight-ps4/pgo", 0777);
+    }
+    const char* name = s_dumps % 2 == 0 ? "/data/dusklight-ps4/pgo/dusklight-a.profraw"
+                                        : "/data/dusklight-ps4/pgo/dusklight-b.profraw";
+    // The runtime appends to an existing file (it would hold every earlier dump too).
+    std::remove(name);
+    __llvm_profile_set_filename(name);
+    const int result = __llvm_profile_write_file();
+    ++s_dumps;
+    std::fprintf(stderr, "[pgo] profile %u written to %s (%d)\n", s_dumps, name, result);
+}
+}
diff --git a/ps4/prof/ps4_profiler.cpp b/ps4/prof/ps4_profiler.cpp
new file mode 100644
index 00000000000..d7e1d5b5cb0
--- /dev/null
+++ b/ps4/prof/ps4_profiler.cpp
@@ -0,0 +1,567 @@
+// SPDX-License-Identifier: MIT
+// The PS4 profiler's reporter (ps4_profiler.hpp). Once a second it compares every zone site with
+// the previous second; a second with a slow frame (a hitch, a scene load) gets the sites that took
+// the time listed. Every ten seconds a summary follows: frame rate, frame times, how busy the main
+// thread and the process were, and the most expensive sites. Lines go to stderr, the title's log
+// (/data/dusklight-ps4/dusklight.log), prefixed "[prof]".
+#include "ps4_profiler.hpp"
+
+#include <algorithm>
+#include <chrono>
+#include <cinttypes>
+#include <cstdio>
