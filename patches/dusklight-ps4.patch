+// SPDX-License-Identifier: MIT
+// Tracy's header with its zone and frame macros routed to the PS4 profiler (ps4_profiler.hpp).
+// ps4/Platform.cmake puts this directory ahead of Tracy's own include directory.
+#pragma once
+
+#include_next <tracy/Tracy.hpp>
+
+#if defined(PS4_PROFILER) && !defined(TRACY_ENABLE)
+#include "../ps4_profiler.hpp"
+
+#undef ZoneScoped
+#undef ZoneScopedN
+#undef ZoneScopedS
+#undef ZoneScopedC
+#undef ZoneScopedNS
+#undef ZoneScopedNC
+#undef FrameMark
+#define ZoneScoped PS4PROF_ZONE(nullptr)
+#define ZoneScopedN(name) PS4PROF_ZONE(name)
+#define ZoneScopedS(depth) PS4PROF_ZONE(nullptr)
+#define ZoneScopedC(color) PS4PROF_ZONE(nullptr)
+#define ZoneScopedNS(name, depth) PS4PROF_ZONE(name)
+#define ZoneScopedNC(name, color) PS4PROF_ZONE(name)
+#define FrameMark ::ps4prof::frame_mark()
+// A thread's CPU time in the profiler's reports; code built for other platforms tests for it.
+#define PS4ProfThreadBusy(name) ::ps4prof::ps4prof_thread_busy(name)
+#define PS4ProfSceneNote(text) ::ps4prof::ps4prof_scene_note(text)
+#endif
