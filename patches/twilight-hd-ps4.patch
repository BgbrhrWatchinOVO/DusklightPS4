+// The selected item's name, from the text box the game writes it to (dMenu_Ring_c::setNameString):
+// the Japanese one on Japanese and early Wii Japanese discs, the western one otherwise. The other
+// set keeps the layout's placeholder ("Sac de bombes prete" on PAL discs) and is not reliably
+// hidden, so visibility cannot choose between them.
+const char* item_bank_name_text(dMenu_Ring_c* ring) {
+    if (ring->mpCenterScreen == nullptr) return "";
+    const u64 tag = dusk::version::isJpnOrLessThanWiiJpn() ? MULTI_CHAR('item_n04') : MULTI_CHAR('fitem_n1');
+    auto* source = static_cast<J2DTextBox*>(ring->mpCenterScreen->search(tag));
+    return source != nullptr ? text_box_string(source) : "";
+}
