+/* ---------------------------------------------------------------------------------------------
+ * The submission thread. sceGnmSubmitCommandBuffers blocks until the GPU has finished the work
+ * submitted before (Dawn's second submission of a frame waited 6-11 ms, the GPU's time for the
+ * frame), so the render thread never recorded a frame while the GPU drew the one before: frame
+ * time = CPU time + GPU time, 40 FPS in Castle Town. Submissions take their sequence number in
+ * order under dev->lock and are queued; this thread hands them to the GPU in that order. */
+
+#define PS4_SUBMIT_QUEUE 64
+
+struct ps4_submit_job {
+   uint64_t seq;
+   uint64_t user_fence_addr;
+   unsigned num_ibs; /* to submit: RADV's, the timestamp IB and the fence IB */
+   unsigned chain_links;
+   uint64_t chain_dwords;
+   void *dcb[64];
+   uint32_t dcb_sizes[64];
+};
+
+/* A submission the system refused: its work is dropped, but its fences must still signal, after
+ * everything before it, or waiters would hang. */
+static void
+ps4_fail_submission(ac_drm_device *dev, const struct ps4_submit_job *job)
+{
+   ps4_wait_seq(dev, job->seq - 1, INT64_MAX);
+   if (job->user_fence_addr)
+      __atomic_store_n((uint64_t *)(uintptr_t)job->user_fence_addr, job->seq, __ATOMIC_RELEASE);
+   __atomic_store_n(dev->fence, job->seq, __ATOMIC_RELEASE);
+}
+
+static void *
+ps4_submit_thread(void *data)
+{
+   ac_drm_device *dev = data;
+   static void *ccb[64];
+   static uint32_t ccb_sizes[64];
+   pthread_mutex_lock(&dev->submit_mutex);
+   for (;;) {
+      while (dev->submit_count == 0)
+         pthread_cond_wait(&dev->submit_cond, &dev->submit_mutex);
+      struct ps4_submit_job *job = &dev->submit_jobs[dev->submit_head];
+      pthread_mutex_unlock(&dev->submit_mutex);
+
+      ps4prof_thread_busy("gnm submit");
+      static void *submit_site;
+      void *submit_zone = ps4prof_enter(&submit_site, "ps4: sceGnmSubmitCommandBuffers (submission thread)");
+#if PS4_WINSYS_DIAG
+      const int64_t start = os_time_get_nano();
+#endif
+      const int r = dev->submit(job->num_ibs, job->dcb, job->dcb_sizes, ccb, ccb_sizes);
+#if PS4_WINSYS_DIAG
+      ps4_note_submit(job->chain_dwords, job->chain_links, os_time_get_nano() - start);
+#endif
+      ps4prof_leave(submit_zone);
+      if (PS4_WINSYS_DIAG && (job->seq <= 40 || job->seq % 1000 == 0))
+         ps4_log("radv/ps4: submit %llu: %u IBs (first %p, %u bytes) = %#x, GPU completed %llu, "
+                 "%llu memory writes checked, %u disabled\n",
+                 (unsigned long long)job->seq, job->num_ibs, job->dcb[0], job->dcb_sizes[0], r,
+                 (unsigned long long)ps4_completed(dev), ps4_writes_checked, ps4_bad_writes);
+      if (r) {
+         ps4_log("radv/ps4: sceGnmSubmitCommandBuffers(%u IBs, submission %llu) = %#x\n", job->num_ibs,
+                 (unsigned long long)job->seq, r);
+         ps4_fail_submission(dev, job);
+      }
+      /* sceGnmSubmitDone tells the system a frame's submissions are complete: once per frame,
+       * and well within its 2 s limit. */
+      const int64_t now = os_time_get_nano();
+      if (now - dev->last_submit_done >= 8000000) {
+         dev->submit_done();
+         dev->last_submit_done = now;
+      }
+
+      pthread_mutex_lock(&dev->submit_mutex);
+      dev->submit_head = (dev->submit_head + 1) % PS4_SUBMIT_QUEUE;
+      dev->submit_count--;
+      pthread_cond_broadcast(&dev->submit_cond);
+   }
+   return NULL;
+}
+
+/* Queues a submission for the thread. Under dev->lock, so the queue is in sequence order; the
+ * thread never takes dev->lock. False if the thread couldn't start (the caller submits itself). */
+static bool
+ps4_queue_submission(ac_drm_device *dev, const struct ps4_submit_job *job)
+{
+   if (!dev->submit_thread_started) {
+      dev->submit_jobs = calloc(PS4_SUBMIT_QUEUE, sizeof(*dev->submit_jobs));
+      pthread_mutex_init(&dev->submit_mutex, NULL);
+      pthread_cond_init(&dev->submit_cond, NULL);
+      pthread_t thread;
+      if (!dev->submit_jobs || pthread_create(&thread, NULL, ps4_submit_thread, dev) != 0) {
+         free(dev->submit_jobs);
+         dev->submit_jobs = NULL;
+         return false;
+      }
+      pthread_detach(thread);
+      dev->submit_thread_started = true;
+      ps4_log("radv/ps4: submissions go to the GPU from their own thread\n");
+   }
+   pthread_mutex_lock(&dev->submit_mutex);
+   while (dev->submit_count == PS4_SUBMIT_QUEUE)
+      pthread_cond_wait(&dev->submit_cond, &dev->submit_mutex);
+   dev->submit_jobs[(dev->submit_head + dev->submit_count) % PS4_SUBMIT_QUEUE] = *job;
+   dev->submit_count++;
+   pthread_cond_broadcast(&dev->submit_cond);
+   pthread_mutex_unlock(&dev->submit_mutex);
+   return true;
+}
+
+/* Waits until the thread has handed everything queued to the GPU (before a submission that
+ * doesn't go through it). */
+static void
+ps4_drain_submissions(ac_drm_device *dev)
+{
+   if (!dev->submit_thread_started)
+      return;
+   pthread_mutex_lock(&dev->submit_mutex);
+   while (dev->submit_count != 0)
+      pthread_cond_wait(&dev->submit_cond, &dev->submit_mutex);
+   pthread_mutex_unlock(&dev->submit_mutex);
+}
