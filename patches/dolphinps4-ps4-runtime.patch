+/* Dwords and links of an IB chain, following each IB's trailing chain packet (diagnostics). */
+static void
+ps4_chain_size(const uint32_t *ib, unsigned num_dw, unsigned *links, uint64_t *dwords)
+{
+   for (unsigned link = 0; link < 256 && num_dw; link++) {
+      (*links)++;
+      *dwords += num_dw;
+      const uint32_t *tail = ib + num_dw - 4;
+      if (num_dw < 4 || tail[0] != 0xC0023F00 || !(tail[3] & (1u << 20)))
+         return;
+      ib = (const uint32_t *)(uintptr_t)(tail[1] | ((uint64_t)(tail[2] & 0xffff) << 32));
+      num_dw = tail[3] & 0xfffff;
+   }
+}
+
+/* How long sceGnmSubmitCommandBuffers takes for small and large submissions, logged every 1024
+ * submissions: a fixed cost per call, or one growing with the command stream? */
+static struct {
+   unsigned count[2];
+   uint64_t dwords[2], links[2], ns[2], max_ns[2];
+} ps4_submit_stats;
+
+static void
+ps4_note_submit(uint64_t dwords, unsigned links, int64_t ns)
+{
+   const int big = dwords >= 4096;
+   ps4_submit_stats.count[big]++;
+   ps4_submit_stats.dwords[big] += dwords;
+   ps4_submit_stats.links[big] += links;
+   ps4_submit_stats.ns[big] += ns;
+   if ((uint64_t)ns > ps4_submit_stats.max_ns[big])
+      ps4_submit_stats.max_ns[big] = ns;
+   if (ps4_submit_stats.count[0] + ps4_submit_stats.count[1] < 1024)
+      return;
+   for (int i = 0; i < 2; i++) {
+      const unsigned n = ps4_submit_stats.count[i];
+      if (n)
+         ps4_log("radv/ps4: %s submissions: %u, avg %llu dwords in %.1f IBs, sceGnmSubmitCommandBuffers avg %llu us max %llu us\n",
+                 i ? "large" : "small", n, (unsigned long long)(ps4_submit_stats.dwords[i] / n),
+                 (double)ps4_submit_stats.links[i] / n, (unsigned long long)(ps4_submit_stats.ns[i] / n / 1000),
+                 (unsigned long long)(ps4_submit_stats.max_ns[i] / 1000));
+   }
+   memset(&ps4_submit_stats, 0, sizeof(ps4_submit_stats));
+}
